def _run_binpath(args: argparse.Namespace) -> int:
    baseline = _load_baseline(BINPATH_BASELINE_PATH)
    violations: list[tuple[str, int, int, list[tuple[int, str]]]] = []
    below = 0
    for p in _binpath_targets(args):
        rel = _rel(p)
        if _is_test_path(rel) or _binpath_excluded(rel) or not p.exists():
            continue
        v = _binpath_violations(p)
        n = len(v)
        allowed = baseline.get(rel, 0)
        if n > allowed:
            violations.append((rel, n, allowed, v))
        elif n < allowed:
            below += 1

    if violations:
        print("✗ new hardcoded platform-divergent command-binary path "
              "(/usr/sbin/chown|lsof, openclaw CLI):\n")
        for rel, n, allowed, hits in violations:
            print(f"  {rel}: {n} literal(s), baseline allows {allowed}")
            for lineno, binary in hits:
                print(f"    L{lineno}: {binary}")
        print(
            "\nThese binaries live at a DIFFERENT path per platform (chown/lsof:\n"
            "/usr/bin/* on Linux; the openclaw CLI: Homebrew symlink vs\n"
            "/usr/bin/openclaw vs node_modules entrypoints). The admin daemon\n"
            "runs them under sudo against a NOPASSWD grant rendered from the\n"
            "platform profile, so a hardcoded path makes sudo prompt for a\n"
            "password — and the daemon has no TTY, so the op fails silently\n"
            "(a chown often leaves a token file root-owned; a forge dispatch\n"
            "dies rc=1). Route the binary through the profile, resolved at\n"
            "call time:\n"
            "    from platform_profile import get_profile\n"
            "    subprocess.run([\"sudo\", get_profile().chown, owner, path])\n"
            "and for the openclaw CLI:\n"
            "    from platform_profile import find_openclaw_cli   # or\n"
            "    from evolve_admin.deploy import _openclaw_bin    # cached\n"
            "Keep a bot's PRIMARY group `:staff` literal (it exists on Ubuntu);\n"
            "only the gid-0 ADMIN group routes through get_profile().admin_group.\n"
            "If a literal is genuinely DATA (not a subprocess call), allowlist\n"
            "the file in tools/platform-path-lint (_BINPATH_ALLOWLIST) in this\n"
            "PR so the exception is reviewable.\n"
        )
        return 1

    if below:
        print(
            f"platform-path-lint[binpath]: {below} file(s) now below baseline — run\n"
            "`tools/platform-path-lint --rule binpath --all --update-baseline` to ratchet down."
        )
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(
        description="Ratchet gates keeping producer code platform-portable."
    )
    ap.add_argument("files", nargs="*", help="specific .py files to lint")
    ap.add_argument("--all", action="store_true", help="lint all in-scope .py")
    ap.add_argument("--staged", action="store_true", help="lint git-staged .py")
    ap.add_argument(
        "--rule", choices=["paths", "blind", "repo", "binpath", "all"], default="all",
        help="which rule class to run (default: all)",
    )
    ap.add_argument(
        "--update-baseline", action="store_true",
        help="regenerate the selected baseline(s) from current counts (requires --all)",
    )
    args = ap.parse_args()

    run_paths = args.rule in ("paths", "all")
    run_blind = args.rule in ("blind", "all")
    run_repo = args.rule in ("repo", "all")
    run_binpath = args.rule in ("binpath", "all")

    if args.update_baseline:
        if not args.all:
            print("--update-baseline requires --all", file=sys.stderr)
            return 2
        if run_paths:
            counts = {_rel(p): _literal_count(p) for p in _iter_production_files()}
            _write_baseline(PATHS_BASELINE_PATH, counts, _PATHS_HEADER)
            total = sum(counts.values())
            files = sum(1 for v in counts.values() if v)
            print(f"paths baseline written: {total} /Users/ literals across {files} files")
        if run_blind:
            counts = {_rel(p): len(_blind_violations(p)) for p in _iter_blind_files()}
            _write_baseline(BLIND_BASELINE_PATH, counts, _BLIND_HEADER)
            total = sum(counts.values())
            files = sum(1 for v in counts.values() if v)
            print(f"blind baseline written: {total} hit(s) across {files} files")
        if run_repo:
            counts = {_rel(p): len(_repo_violations(p)) for p in _iter_production_files()}
            _write_baseline(REPO_BASELINE_PATH, counts, _REPO_HEADER)
            total = sum(counts.values())
            files = sum(1 for v in counts.values() if v)
            print(f"repo baseline written: {total} literal(s) across {files} files")
        if run_binpath:
            counts = {_rel(p): len(_binpath_violations(p)) for p in _iter_binpath_files()}
            _write_baseline(BINPATH_BASELINE_PATH, counts, _BINPATH_HEADER)
            total = sum(counts.values())
            files = sum(1 for v in counts.values() if v)
            print(f"binpath baseline written: {total} literal(s) across {files} files")
        return 0

    exit_code = 0
    if run_paths and _run_paths(args):
        exit_code = 1
    if run_blind and _run_blind(args):
        exit_code = 1
    if run_repo and _run_repo(args):
        exit_code = 1
    if run_binpath and _run_binpath(args):
        exit_code = 1

    if exit_code == 0:
        print("platform-path-lint: OK")
    return exit_code


if __name__ == "__main__":
    sys.exit(main())
