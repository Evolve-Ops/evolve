def _write_baseline(path: Path, counts: dict[str, int], header: tuple[str, ...]) -> None:
    lines = list(header) + [""]
    for p in sorted(counts):
        if counts[p] > 0:
            lines.append(f"{counts[p]}\t{p}")
    path.write_text("\n".join(lines) + "\n", encoding="utf-8")


def _rel(p: Path) -> str:
    try:
        return str(p.resolve().relative_to(REPO_ROOT))
    except ValueError:
        return str(p)


# ── rule runners ──────────────────────────────────────────────────────────────
def _paths_targets(args: argparse.Namespace) -> list[Path]:
    if args.all:
        return _iter_production_files()
    if args.staged:
        return _staged_py_files()
    return [Path(f) for f in args.files if f.endswith(".py")]


def _run_paths(args: argparse.Namespace) -> int:
    baseline = _load_baseline(PATHS_BASELINE_PATH)
    violations: list[tuple[str, int, int]] = []
    below = 0
    for p in _paths_targets(args):
        rel = _rel(p)
        if _is_test_path(rel) or rel in _ALLOWLIST or not p.exists():
            continue
        n = _literal_count(p)
        allowed = baseline.get(rel, 0)
        if n > allowed:
            violations.append((rel, n, allowed))
        elif n < allowed:
            below += 1

    if violations:
        print("✗ new hardcoded /Users/ path literal(s):\n")
        for rel, n, allowed in violations:
            print(f"  {rel}: {n} literal(s), baseline allows {allowed}")
        print(
            "\n/Users/ is macOS-only (8.3 Linux port). Resolve homes via the\n"
            "blessed helpers — evolve_config.bot_home(bot_id) for logical ids,\n"
            "evolve_config.user_home(account) for resolved accounts — and take\n"
            "platform defaults (shared dir, deploy checkout, daemon dir,\n"
            "command paths) from platform_profile.get_profile(). If a literal\n"
            "is truly unavoidable, bump tools/platform-path-baseline.txt in\n"
            "this PR so the exception is reviewable.\n"
        )
        return 1

    if below:
        print(
            f"platform-path-lint[paths]: {below} file(s) now below baseline — run\n"
            "`tools/platform-path-lint --rule paths --all --update-baseline` to ratchet down."
        )
    return 0


def _blind_targets(args: argparse.Namespace) -> list[Path]:
    if args.all:
        return _iter_blind_files()
    if args.staged:
        return _staged_blind_files()
    return [Path(f) for f in args.files if f.endswith(".py")]


def _run_blind(args: argparse.Namespace) -> int:
    baseline = _load_baseline(BLIND_BASELINE_PATH)
    violations: list[tuple[str, int, int, list[tuple[int, str, str]]]] = []
    below = 0
    for p in _blind_targets(args):
        rel = _rel(p)
        if _is_test_path(rel) or _blind_excluded(rel) or not p.exists():
            continue
        v = _blind_violations(p)
        n = len(v)
        allowed = baseline.get(rel, 0)
        if n > allowed:
            violations.append((rel, n, allowed, v))
        elif n < allowed:
            below += 1

    if violations:
        print("✗ new platform-blind producer/monitor code:\n")
        for rel, n, allowed, hits in violations:
            print(f"  {rel}: {n} hit(s), baseline allows {allowed}")
            for lineno, kind, detail in hits:
                if kind == "binary":
                    print(f"    L{lineno}: macOS-only binary `{detail}` in a subprocess call")
                else:
                    print(f"    L{lineno}: macOS-only string in `{detail}=` message")
        print(
            "\nThese FileNotFoundError into false CRITICALs on a Linux/VPS pod.\n"
            "Gate the check behind a platform branch — e.g.\n"
            "    from platform_profile import get_profile\n"
            "    if get_profile().name != \"macos\":\n"
            "        return []   # or a 'skipped' Finding / no Signal\n"
            "— or add the Linux equivalent behind the matching branch. If a\n"
            "hit is genuinely unavoidable, bump tools/platform-blind-baseline.txt\n"
            "in this PR so the exception is reviewable.\n"
        )
        return 1

    if below:
        print(
            f"platform-path-lint[blind]: {below} file(s) now below baseline — run\n"
            "`tools/platform-path-lint --rule blind --all --update-baseline` to ratchet down."
        )
    return 0


def _repo_targets(args: argparse.Namespace) -> list[Path]:
