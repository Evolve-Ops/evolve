{
  "version": 1,
  "description": "Defer-tool reliability eval set. Each prompt records expected bot behavior so we can measure the bot's defer-call rate (true positives), false-positive rate (defer called when it shouldn't be), and time-accuracy (due_at within tolerance of expected). Re-run after system-prompt changes to track regressions/improvements.",
  "schema": {
    "id": "stable identifier — never change for an existing prompt; used in result diffs across runs",
    "category": "'should_defer' | 'should_not_defer'",
    "subcategory": "loose grouping for analyzing failure modes (time-anchored, event-anchored, recurring, advice, completed-task, etc.)",
    "text": "the user message sent to the bot",
    "expected": {
      "called_defer": "bool — whether the bot SHOULD call defer for this prompt",
      "mode": "'message' | 'action' | null — only relevant when called_defer=true",
      "due_at_offset_minutes": "expected offset from prompt time, in minutes; null when timing isn't asserted",
      "due_at_tolerance_minutes": "± tolerance; bot's arithmetic isn't exact"
    }
  },
  "prompts": [
    {
      "id": "should-defer-001",
      "category": "should_defer",
      "subcategory": "explicit-time-message",
      "text": "tell me in 5 minutes what your favorite color is",
      "expected": {
        "called_defer": true,
        "mode": "message",
        "due_at_offset_minutes": 5,
        "due_at_tolerance_minutes": 1
      }
    },
    {
      "id": "should-defer-002",
      "category": "should_defer",
