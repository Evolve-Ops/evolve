# run one command, so the call is refused before anything else is considered.
# Quotes are NOT here: `grep "a b" <path>` is a legitimate single command and
# shlex parses it without giving the remote shell a second verb.
METACHARS: tuple[str, ...] = (";", "&", "|", "`", "$", ">", "<", "\n", "\r", "\\")

