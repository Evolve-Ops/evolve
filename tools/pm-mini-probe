# ─────────────────────────────────────────────────────────────────────────────
# Path set — the only trees an operand may name.
#
# These are anchored regexes matched against a whole absolute-path token. A
# token that starts with "/" and matches none of them is refused by the
# `path-outside-allowlist` rule.
#
# The `/Users/Shared/evolve` entry deliberately covers the sibling trees the
# pod keeps beside it (`-repo`, `-venv`, `-plugin`, `-staging`, `-backup`,
# `-investigation`): the brief's own acceptance line is
# `readlink -f /Users/Shared/evolve-venv/bin/python3`, which is in none of the
# others. The `-<word>` suffix is required, so `/Users/Shared/evolveX` does
# not match.
# ─────────────────────────────────────────────────────────────────────────────
PATH_ROOTS: tuple[str, ...] = (
    r"/Users/Shared/evolve(?:-[A-Za-z0-9._]+)?(?:/.*)?",
    r"/Users/[^/]+/\.openclaw(?:/.*)?",
    r"/tmp/pm(?:/.*)?",
    r"/private/tmp/pm(?:/.*)?",
    r"/var/log(?:/.*)?",
    r"/Library/LaunchDaemons/ai\.evolve\.[A-Za-z0-9._-]+",
)
_PATH_ROOT_RES = tuple(re.compile(rf"^{p}$") for p in PATH_ROOTS)

# The root-owned, fixed-argv reader on the pod. `sudo cat <path>` is rewritten
# to `sudo <this> <path>` before the command is sent: /etc/sudoers.d/pm-probe
# grants root for THIS program and nothing else that reads files, because sudo
# cannot bound a path operand (its `*` crosses `/` and spaces) and `cat`
# follows symlinks out of the bot-writable trees below. The reader realpaths
# its operand, re-checks the root set after resolution, refuses a symlink at
# every component and caps output at MAX_OUTPUT_BYTES.
# Source: packages/admin/evolve_admin/pm_probe_cat.py.
PM_PROBE_CAT = "/usr/local/libexec/pm-probe-cat"

# Credential-shaped path segments, refused before the command is sent. Masking
# stays as the second net; these keep the file from being opened at all. Keep
# in step with `SECRET_SEGMENT_GLOBS` in pm_probe_cat.py — a test pins them equal.
SECRET_SEGMENT_GLOBS: tuple[str, ...] = (
    "auth*", "credentials*", ".env*", "*.pem", "*.key", "id_*",
)
SECRET_DIR_PAIR: tuple[str, str] = ("docs", "private")

