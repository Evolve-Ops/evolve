class Refused(Exception):
    """A command did not survive the allowlist. ``rule`` names what caught it."""

    def __init__(self, rule: str, detail: str) -> None:
        super().__init__(f"{rule}: {detail}")
        self.rule = rule
        self.detail = detail


# ─────────────────────────────────────────────────────────────────────────────
# Allowlist
# ─────────────────────────────────────────────────────────────────────────────

def _is_flag(tok: str) -> bool:
    return tok.startswith("-") and tok != "-"


def _path_allowed(tok: str) -> bool:
    """True when an absolute-path token names something inside the path set."""
    return any(rx.match(tok) for rx in _PATH_ROOT_RES)


def _check_write_flag(tok: str) -> None:
    if not _is_flag(tok):
        return
    name = tok.split("=", 1)[0].lstrip("-")
    parts = [p for p in name.split("-") if p]
    hit = next((p for p in parts if p in WRITE_FLAG_WORDS), None)
    if hit is not None:
        raise Refused("write-flag", f"{tok!r} names an output/mutation flag ({hit!r})")


def _check_secret_path(tok: str) -> None:
    """Refuse a credential-shaped operand — the deny rule ahead of masking.

    Masking is a heuristic over the OUTPUT (it misses a value with a `.` in
    it, a short one, an unlabelled one in `ps aux` argv). This is a property
    of the OPERAND, so it holds regardless of what the file turns out to
    contain. Mirrored in pm_probe_cat.py so the pod refuses too.
    """
    segs = [s for s in tok.split("/") if s]
    for seg in segs:
        low = seg.lower()
        for glob in SECRET_SEGMENT_GLOBS:
            if fnmatch.fnmatchcase(low, glob):
                raise Refused(
                    "secret-path",
                    f"{seg!r} matches {glob!r} — the reads the PM needs do not need "
                    f"the key bytes, so this door does not open credential files at all",
                )
    for a, b in zip(segs, segs[1:]):
        if (a.lower(), b.lower()) == SECRET_DIR_PAIR:
            raise Refused(
                "secret-path", f"{'/'.join(SECRET_DIR_PAIR)}/ is private by construction",
            )


def _check_operand(tok: str, *, allow_bare: bool) -> None:
    """Vet one non-leading token of an otherwise-allowed command.

    ``allow_bare`` permits a value that is not a path (a bot id, a date, a
    grep pattern). A token that starts with "/" is always held to the path set;
    a token that merely contains "/" is a relative path — refused, because the
    remote cwd is the operator's home and a relative path escapes the set.

    The secret-path deny runs AFTER the root check, so a credential file
    outside the allowlist still reads as `path-outside-allowlist` (the wider
    fact about it) and one inside reads as `secret-path`.
    """
    _check_write_flag(tok)
    if _is_flag(tok):
        # `--shared-dir=/Users/Shared/evolve` carries its operand inline.
        if "=" in tok:
            _check_operand(tok.split("=", 1)[1], allow_bare=True)
        return
    if tok.startswith("/"):
        if not _path_allowed(tok):
            raise Refused("path-outside-allowlist", f"{tok!r} is not under an allowed root")
        _check_secret_path(tok)
        return
    if not allow_bare:
        raise Refused(
            "relative-path",
            f"{tok!r} is not an absolute path — the remote cwd is the admin account's "
            f"home, which is outside the path set; give a full path under an allowed root",
        )
    _check_secret_path(tok)


def _rule_analyzer_script(toks: list[str]) -> str | None:
    """`python3 <analyzer or staged script> [args]` — rule `analyzer-script`."""
    sudo = toks[0] == "sudo"
    rest = toks[1:] if sudo else toks
    if len(rest) < 2 or rest[0] not in PYTHON_INTERPRETERS:
        return None
    if sudo:
        raise Refused(
            "analyzer-script",
            "no interpreter is granted root: context_census.py requires a free "
            "--bot value, so no exact form can be written into sudoers, and the "
            "wildcard that stood in for one handed root any argument string "
            "(--json-out included). Run it without sudo — the admin account "
            "reads every bot's .openclaw/ through the ensure-pod-perms ACL",
        )
    script = rest[1]
    in_analyzer = script.startswith(ANALYZER_DIR + "/")
    in_staged = script.startswith(STAGED_SCRIPT_DIR + "/")
    if not (in_analyzer or in_staged):
        raise Refused(
            "analyzer-script",
            f"{script!r} is not under {ANALYZER_DIR} or {STAGED_SCRIPT_DIR}",
        )
    name = script.rsplit("/", 1)[1]
    if not re.fullmatch(r"[A-Za-z0-9_]+\.py", name):
        raise Refused("analyzer-script", f"{name!r} is not a plain <name>.py script")
    if script != f"{ANALYZER_DIR}/{name}" and script != f"{STAGED_SCRIPT_DIR}/{name}":
        raise Refused("analyzer-script", f"{script!r} is nested below the script directory")
    pinned = ANALYZER_SCRIPT_FLAGS.get(name)
    for tok in rest[2:]:
        _check_operand(tok, allow_bare=True)
        if pinned is not None and _is_flag(tok):
            flag = tok.split("=", 1)[0]
            if flag not in pinned:
                raise Refused(
                    "analyzer-unknown-flag",
                    f"{flag!r} is not one of the flags {name} accepts ({sorted(pinned)}) — "
                    f"this table is read off the script's own parser, not guessed from the name",
                )
    return "analyzer-script"


def _rule_evolve_admin_read(toks: list[str]) -> str | None:
    """`[sudo] evolve-admin <read verb> [args]` — rule `evolve-admin-read`.

    Under sudo the WHOLE form must be one /etc/sudoers.d/pm-probe writes out
    (SUDO_EVOLVE_ADMIN_FORMS). Refusing here rather than letting the pod
    refuse matters: an ungranted form prompts for a password, and over a
    BatchMode ssh that comes back as silence, not as an error the PM can read.
    """
    sudo = toks[0] == "sudo"
    rest = toks[1:] if sudo else toks
    if not rest or rest[0] not in EVOLVE_ADMIN_NAMES:
        return None
    tail = rest[1:]
    verb: tuple[str, ...] | None = None
    for n in (2, 1):
        cand = tuple(tail[:n])
        if cand in EVOLVE_ADMIN_READS:
            verb = cand
            break
    if verb is None:
        words = [t for t in tail if not _is_flag(t)]
        raise Refused(
            "evolve-admin-mutating",
            f"{' '.join(words[:2]) or '<no verb>'!r} is not one of the enumerated read verbs "
            f"{sorted(' '.join(v) for v in EVOLVE_ADMIN_READS)}",
        )
    args = tail[len(verb):]
    for required in EVOLVE_ADMIN_READS[verb]:
        if required not in args:
            raise Refused(
                "evolve-admin-mutating",
                f"{' '.join(verb)!r} is a read only with {required!r}; without it, it applies changes",
            )
    accepted = EVOLVE_ADMIN_FLAGS[verb]
    expect_value = False
    for tok in args:
        if expect_value:
            expect_value = False
            _check_operand(tok, allow_bare=True)
            continue
        # `--check-only` is a read flag whose name contains none of the write
        # words; the generic operand check still vets everything else.
        _check_operand(tok, allow_bare=True)
        if not _is_flag(tok):
            continue
        flag = tok.split("=", 1)[0]
        if flag not in accepted:
            raise Refused(
                "evolve-admin-unknown-flag",
                f"{flag!r} is not one of the flags '{' '.join(verb)}' accepts "
                f"({sorted(accepted)}) — the table is read off its click parser",
            )
        if "=" not in tok and flag in EVOLVE_ADMIN_VALUE_FLAGS:
            expect_value = True
    if sudo and tuple(tail) not in SUDO_EVOLVE_ADMIN_FORMS:
        raise Refused(
            "evolve-admin-sudo-ungranted",
            f"'{' '.join(tail)}' is not one of the exact forms /etc/sudoers.d/pm-probe "
            f"grants root ({sorted(' '.join(f) for f in SUDO_EVOLVE_ADMIN_FORMS)}); "
            f"run it without sudo, or widen the grant deliberately",
        )
    return "evolve-admin-read"


def _rule_read_tool(toks: list[str]) -> str | None:
    """`[sudo] <read tool> [args] <path>...` — rule `read-tool`."""
    sudo = toks[0] == "sudo"
    rest = toks[1:] if sudo else toks
    if not rest:
        return None
    tool = rest[0]
    if tool not in READ_TOOLS:
        return None
    if sudo and tool != "cat":
        raise Refused(
            "read-tool",
            f"sudo is granted for 'cat' only; {tool!r} under sudo would prompt for a password",
        )
    args = rest[1:]

    if sudo and tool == "cat":
        # Rewritten to `sudo PM_PROBE_CAT <path>` before it is sent, and that
        # reader takes exactly one operand and no flags. Mirror its contract
        # here so the refusal is legible on the laptop instead of arriving as
        # a non-zero exit from the pod.
        if len(args) != 1 or _is_flag(args[0]):
            raise Refused(
                "read-tool",
                f"'sudo cat' reads exactly one path through {PM_PROBE_CAT} — "
                f"no flags, no second operand (got {args!r})",
            )
        _check_operand(args[0], allow_bare=False)
        return "read-tool"

    if tool == "readlink":
        if "-f" not in args:
            raise Refused("read-tool", "readlink is allowed only as 'readlink -f <path>'")
    if tool == "launchctl":
        if not args or args[0] != "print":
            raise Refused(
                "launchctl-nonprint",
                f"launchctl {args[0] if args else '<no verb>'!r} — only 'launchctl print' is a read",
            )
        for tok in args[1:]:
            if _is_flag(tok):
                _check_write_flag(tok)
                continue
            if not _LAUNCHCTL_TARGET_RE.match(tok):
                raise Refused("read-tool", f"{tok!r} is not a launchctl domain target")
        return "read-tool"

    if tool in READ_TOOLS_NO_PATH:
        for tok in args:
            _check_write_flag(tok)
            if tok.startswith("/"):
                raise Refused("path-outside-allowlist", f"{tool} takes no path operands ({tok!r})")
        return "read-tool"

    # grep's first non-flag operand is the pattern, not a path.
    pattern_slots = 1 if tool == "grep" else 0
    value_flags = VALUE_FLAGS.get(tool, frozenset())
    seen_paths = 0
    expect_value = False
    for tok in args:
        if expect_value:
            expect_value = False
            _check_operand(tok, allow_bare=True)
            continue
        if _is_flag(tok):
            _check_write_flag(tok)
            if "=" in tok:
                _check_operand(tok.split("=", 1)[1], allow_bare=True)
            elif tok in value_flags:
                expect_value = True
            continue
        if pattern_slots:
            pattern_slots -= 1
            continue
        _check_operand(tok, allow_bare=False)
        seen_paths += 1
    if tool in READ_TOOLS_NEEDING_PATH and seen_paths == 0:
        raise Refused(
            "read-tool",
            f"{tool} needs at least one allowed path operand — with none it reads stdin and hangs",
        )
    return "read-tool"


def _rule_firewall_state(toks: list[str]) -> str | None:
    """`socketfilterfw --getglobalstate|--listapps` — rule `firewall-state`."""
    if toks[0] != SOCKETFILTERFW:
        return None
    if len(toks) != 2 or toks[1] not in SOCKETFILTERFW_FLAGS:
        raise Refused(
            "firewall-state",
            f"socketfilterfw is allowed only with exactly one of {sorted(SOCKETFILTERFW_FLAGS)}",
        )
    return "firewall-state"


ALLOW_RULES = (
    _rule_analyzer_script,
    _rule_evolve_admin_read,
    _rule_read_tool,
    _rule_firewall_state,
)


def _deny_pass(cmd: str, toks: list[str]) -> None:
    """Named refusals, evaluated before any allow rule so the message is precise."""
    for ch in METACHARS:
        if ch in cmd:
            raise Refused(
                "metachar",
                f"{ch!r} would let the remote shell run more than one command — one command per call",
            )
    for tok in toks:
        for seg in tok.split("/"):
            if seg == "..":
                raise Refused("path-traversal", f"{tok!r} contains a '..' segment")
    for tok in toks:
        base = tok.rsplit("/", 1)[-1]
        if base == "openclaw":
            raise Refused("openclaw-forbidden", "the openclaw CLI is out of scope for this door")

    head = toks[1] if toks[0] == "sudo" and len(toks) > 1 else toks[0]
    base = head.rsplit("/", 1)[-1]
    if base in MUTATING_BINARIES:
        raise Refused("mutating-binary", f"{base!r} can change state on the pod")
    if base == "git":
        verb = next((t for t in toks[toks.index(head) + 1:] if not _is_flag(t)), None)
        if verb in GIT_MUTATING_VERBS:
            raise Refused("git-mutating", f"'git {verb}' mutates the checkout")


def classify(cmd: str) -> str:
    """Return the name of the allow rule that admits ``cmd``.

    Raises :class:`Refused` — whose ``rule`` names the matching deny rule, or
    ``not-allowlisted`` when nothing admitted it — otherwise.
    """
    if not cmd or not cmd.strip():
        raise Refused("empty-command", "no command given")
    try:
        toks = shlex.split(cmd)
    except ValueError as exc:
        raise Refused("unparseable", f"could not parse the command: {exc}") from exc
    if not toks:
        raise Refused("empty-command", "no command given")

    _deny_pass(cmd, toks)

    for rule in ALLOW_RULES:
        matched = rule(toks)
        if matched:
            return matched
    raise Refused(
        "not-allowlisted",
        f"{toks[0]!r} is not one of the allowed command shapes "
        f"(analyzer-script, evolve-admin-read, read-tool, firewall-state)",
    )


def remote_command(cmd: str) -> str:
    """The command actually sent to the pod — ``cmd``, with `sudo cat` rewritten.

    ``sudo cat <path>`` becomes ``sudo <PM_PROBE_CAT> <path>``: the sudoers
    file grants root for that reader and for no ``cat``, because sudo cannot
    bound a path operand and ``cat`` follows symlinks. Call AFTER
    :func:`classify`, which is what guarantees the three-token shape.
    """
    try:
        toks = shlex.split(cmd)
    except ValueError:  # pragma: no cover — classify() already refused it
        return cmd
    if len(toks) == 3 and toks[0] == "sudo" and toks[1] == "cat":
        return f"sudo {PM_PROBE_CAT} {shlex.quote(toks[2])}"
    return cmd


# ─────────────────────────────────────────────────────────────────────────────
# Secret masking — no key bytes leave the pod through this door.
# ─────────────────────────────────────────────────────────────────────────────

# Each is anchored with a "not preceded by a word character" lookbehind so an
# ordinary word ending in `sk-` (a branch name, a slug) is not mistaken for a
# key and mangled into unreadable output.
_NW = r"(?<![A-Za-z0-9])"
_SECRET_RES: tuple[re.Pattern[str], ...] = (
    re.compile(_NW + r"sk-ant-[A-Za-z0-9_\-]{8,}"),
    re.compile(_NW + r"github_pat_[A-Za-z0-9_]{20,}"),
    re.compile(_NW + r"gh[pousr]_[A-Za-z0-9]{20,}"),
    re.compile(_NW + r"xai-[A-Za-z0-9_\-]{16,}"),
    re.compile(_NW + r"AIza[A-Za-z0-9_\-]{20,}"),
    re.compile(_NW + r"sk-[A-Za-z0-9_\-]{16,}"),
    # A long opaque run introduced by a token/key/secret label — the shape of
    # a value in openclaw.json, auth-profiles.json or an env dump.
    re.compile(
        r"(?i)(?:token|key|secret|password|passwd|bearer)[\"']?\s*[:=]\s*[\"']?"
        r"(?P<v>[A-Za-z0-9+/_\-]{40,}={0,2})"
    ),
)


def _mask_value(s: str) -> str:
    """first 8 + last 4, per the brief — enough to identify, not to use."""
    if len(s) <= 12:
        return "***MASKED***"
    return f"{s[:8]}***MASKED***{s[-4:]}"


def mask_secrets(text: str) -> str:
    """Replace key-shaped runs with a first-8 / last-4 stub."""
    if not text:
        return text
    for rx in _SECRET_RES:
        def _sub(m: re.Match[str]) -> str:
            if "v" in (m.groupdict() or {}) and m.group("v") is not None:
                whole, val = m.group(0), m.group("v")
                return whole[: m.start("v") - m.start(0)] + _mask_value(val)
            return _mask_value(m.group(0))
        text = rx.sub(_sub, text)
    return text


# ─────────────────────────────────────────────────────────────────────────────
# Audit — every call, allowed or refused. Never the output.
# ─────────────────────────────────────────────────────────────────────────────

class AuditUnwritable(Exception):
    """The audit log could not be opened for append."""


def audit_path() -> str:
    return os.path.expanduser(os.environ.get("PM_PROBE_LOG") or DEFAULT_LOG)


def ensure_audit_writable() -> str:
    """Open-and-close the audit log for append; raise if that cannot be done.

    Called BEFORE the allowlist and before ssh: a call that cannot be recorded
    does not happen. Silence is not an option.
    """
    path = audit_path()
    try:
        parent = os.path.dirname(path)
        if parent:
            os.makedirs(parent, exist_ok=True)
        with open(path, "a", encoding="utf-8"):
            pass
    except OSError as exc:
        raise AuditUnwritable(f"audit log {path!r} is not writable: {exc}") from exc
    return path


def audit(entry: dict) -> None:
    path = audit_path()
    line = json.dumps(entry, sort_keys=True, ensure_ascii=False)
    try:
        with open(path, "a", encoding="utf-8") as fh:
            fh.write(line + "\n")
    except OSError as exc:
        raise AuditUnwritable(f"audit log {path!r} is not writable: {exc}") from exc


# ─────────────────────────────────────────────────────────────────────────────
# The one tool
# ─────────────────────────────────────────────────────────────────────────────

def _truncate(text: str) -> tuple[str, bool]:
    raw = text.encode("utf-8")
    if len(raw) <= MAX_OUTPUT_BYTES:
        return text, False
    return raw[:MAX_OUTPUT_BYTES].decode("utf-8", "replace"), True


def run(cmd: str, timeout_s: int = DEFAULT_TIMEOUT_S) -> dict:
    """Run one allowlisted command on the pod and return its masked output.

    Returns ``{stdout, stderr, exit, truncated}`` on success, or
    ``{error, rule}`` when the allowlist refused it. Never raises for a
    refusal — a refusal is a result the PM should read, not a crash.
    """
    ts = datetime.now(timezone.utc).isoformat(timespec="seconds")
    try:
        ensure_audit_writable()
    except AuditUnwritable as exc:
        # Deliberately NOT a refusal record: there is nowhere to record it.
        return {"error": str(exc), "rule": "audit-unwritable"}

    try:
        rule = classify(cmd)
    except Refused as exc:
        audit({"ts": ts, "cmd": cmd, "exit": None, "bytes": 0, "refused_by": exc.rule})
        return {"error": str(exc), "rule": exc.rule}

    try:
        timeout = int(timeout_s)
    except (TypeError, ValueError):
        timeout = DEFAULT_TIMEOUT_S
    timeout = max(MIN_TIMEOUT_S, min(MAX_TIMEOUT_S, timeout))

    host = os.environ.get("PM_PROBE_HOST") or DEFAULT_HOST
    ssh = os.environ.get("PM_PROBE_SSH") or "ssh"
    remote = remote_command(cmd)
    argv = [ssh, "-o", "BatchMode=yes", host, remote]

    started = time.time()
    try:
        proc = subprocess.run(
            argv,
            capture_output=True,
            text=True,
            timeout=timeout,
            stdin=subprocess.DEVNULL,
        )
        out_raw, err_raw, code = proc.stdout or "", proc.stderr or "", proc.returncode
    except subprocess.TimeoutExpired:
        out_raw, err_raw, code = "", f"pm-mini-probe: timed out after {timeout}s", None
    except OSError as exc:
        out_raw, err_raw, code = "", f"pm-mini-probe: could not run {ssh!r}: {exc}", None

    stdout, t1 = _truncate(mask_secrets(out_raw))
    stderr, t2 = _truncate(mask_secrets(err_raw))
    result = {
        "stdout": stdout,
        "stderr": stderr,
        "exit": code,
        "truncated": t1 or t2,
        "rule": rule,
        "host": host,
        "elapsed_s": round(time.time() - started, 3),
    }
    entry = {
        "ts": ts,
        "cmd": cmd,
        "exit": code,
        "bytes": len(stdout.encode("utf-8")) + len(stderr.encode("utf-8")),
    }
    if remote != cmd:
        # What the PM asked for and what the pod ran are both facts; the log
        # (and the result) carry both rather than quietly substituting one.
        result["remote"] = remote
        entry["remote"] = remote
    audit(entry)
    return result


