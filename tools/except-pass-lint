#!/usr/bin/env python3
"""except-pass-lint — ratchet gate on silently-swallowed exceptions.

A "silent swallow" is an ``except`` handler whose body does nothing but
``pass`` (or ``...``). It hides real errors. The 80->100 roadmap (item 4.2)
calls out ~900+ of these in production code as a maintainability and
reliability risk. Fixing them all at once is infeasible and risky; this
gate does the durable thing instead: it freezes the current count as a
per-file baseline, BLOCKS any change that adds a new swallow, and lets the
baseline ratchet DOWN as handlers are fixed.

Same shape as ci-quarantine.txt (test failures) and ui-style-lint (style
debt): a checked-in baseline that can only shrink.

Detection is AST-based (not regex): an ``ast.ExceptHandler`` whose body is
exactly one ``pass`` or ``...``. Comments are invisible to the AST, so
``except X:  # intentional\n    pass`` still counts — if a swallow is truly
intentional, acknowledge it by bumping the baseline (``--update-baseline``),
which leaves a reviewable diff rather than a silent exception.

Usage:
  tools/except-pass-lint <file.py> [<file.py> ...]   # lint specific files
  tools/except-pass-lint --all                       # lint all production .py
  tools/except-pass-lint --staged                    # lint git-staged .py
  tools/except-pass-lint --all --update-baseline     # regenerate the baseline

Exit status: 0 if no file exceeds its baseline; 1 if a new swallow appeared.
"""
from __future__ import annotations

import argparse
import ast
import os
import subprocess
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
BASELINE_PATH = REPO_ROOT / "tools" / "except-pass-baseline.txt"

# Production code only. Test files are allowed to swallow in setup/teardown
# without masking a user-facing bug, and including them would bloat the
# baseline without protecting the runtime.
_LINT_ROOTS = ("packages",)


def _is_test_path(rel: str) -> bool:
    parts = rel.replace("\\", "/").split("/")
    if any(p in ("tests", "test") for p in parts):
        return True
    base = parts[-1]
    return base.startswith("test_") or base == "conftest.py"


def _silent_swallow_count(path: Path) -> int:
    """Number of ``except`` handlers in *path* whose body is just pass/...."""
    try:
        tree = ast.parse(path.read_text(encoding="utf-8"))
    except (SyntaxError, UnicodeDecodeError, ValueError):
        return 0
    n = 0
    for node in ast.walk(tree):
        if isinstance(node, ast.ExceptHandler) and len(node.body) == 1:
            stmt = node.body[0]
            if isinstance(stmt, ast.Pass):
                n += 1
            elif (
                isinstance(stmt, ast.Expr)
                and isinstance(stmt.value, ast.Constant)
                and stmt.value.value is Ellipsis
            ):
                n += 1
    return n


def _iter_production_files() -> list[Path]:
    out: list[Path] = []
    for root in _LINT_ROOTS:
        for dirpath, _dirs, files in os.walk(REPO_ROOT / root):
            if "__pycache__" in dirpath:
                continue
            for f in files:
                if not f.endswith(".py"):
                    continue
                p = Path(dirpath) / f
                rel = str(p.relative_to(REPO_ROOT))
                if _is_test_path(rel):
                    continue
                out.append(p)
    return out


def _load_baseline() -> dict[str, int]:
    if not BASELINE_PATH.exists():
        return {}
    baseline: dict[str, int] = {}
    for line in BASELINE_PATH.read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        parts = line.split("\t", 1)  # "<count>\t<path>"
        if len(parts) != 2:
            continue
        try:
            baseline[parts[1]] = int(parts[0])
        except ValueError:
            continue
    return baseline


def _write_baseline(counts: dict[str, int]) -> None:
    lines = [
        "# except-pass-baseline — silent `except: pass` / `...` counts per file.",
        "# Generated by `tools/except-pass-lint --all --update-baseline`. The lint",
        "# blocks any file that EXCEEDS its count, so this file may only ratchet",
        "# DOWN: fix a swallow -> rerun --update-baseline -> the number drops.",
        "# Goal state: this file is empty.",
        "",
    ]
    for path in sorted(counts):
        if counts[path] > 0:
            lines.append(f"{counts[path]}\t{path}")
    BASELINE_PATH.write_text("\n".join(lines) + "\n", encoding="utf-8")


def _staged_py_files() -> list[Path]:
    r = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "--diff-filter=ACM"],
        cwd=REPO_ROOT, capture_output=True, text=True,
    )
    out = []
    for name in r.stdout.splitlines():
        if name.endswith(".py") and not _is_test_path(name):
            p = REPO_ROOT / name
            if p.exists():
                out.append(p)
    return out


def _rel(p: Path) -> str:
    try:
        return str(p.resolve().relative_to(REPO_ROOT))
    except ValueError:
        return str(p)


def main() -> int:
    ap = argparse.ArgumentParser(
        description="Ratchet gate on silently-swallowed exceptions (except: pass)."
    )
    ap.add_argument("files", nargs="*", help="specific .py files to lint")
    ap.add_argument("--all", action="store_true", help="lint all production .py")
    ap.add_argument("--staged", action="store_true", help="lint git-staged .py")
    ap.add_argument(
        "--update-baseline", action="store_true",
        help="regenerate the baseline from current counts (requires --all)",
    )
    args = ap.parse_args()

    baseline = _load_baseline()

    if args.update_baseline:
        if not args.all:
            print("--update-baseline requires --all", file=sys.stderr)
            return 2
        counts = {
            _rel(p): _silent_swallow_count(p) for p in _iter_production_files()
        }
        _write_baseline(counts)
        total = sum(counts.values())
        files = sum(1 for v in counts.values() if v)
        print(f"baseline written: {total} silent swallows across {files} files")
        return 0

    if args.all:
        targets = _iter_production_files()
    elif args.staged:
        targets = _staged_py_files()
    else:
        targets = [Path(f) for f in args.files if f.endswith(".py")]

    violations = []
    below = 0
    for p in targets:
        rel = _rel(p)
        if _is_test_path(rel) or not p.exists():
            continue
        n = _silent_swallow_count(p)
        allowed = baseline.get(rel, 0)
        if n > allowed:
            violations.append((rel, n, allowed))
        elif n < allowed:
            below += 1

    if violations:
        print("✗ new silent exception swallow(s) (except: pass / ...):\n")
        for rel, n, allowed in violations:
            print(f"  {rel}: {n} swallow(s), baseline allows {allowed}")
        print(
            "\nA bare `except: pass` hides real errors. Either handle/log the\n"
            "exception, or — if the swallow is genuinely intentional — record it:\n"
            "  tools/except-pass-lint --all --update-baseline"
        )
        return 1

    if below and (args.all or args.staged):
        print(
            f"✓ no new silent swallows. {below} file(s) now BELOW baseline — "
            "run `tools/except-pass-lint --all --update-baseline` to ratchet down."
        )
    else:
        print("✓ no new silent exception swallows.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
