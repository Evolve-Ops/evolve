#!/usr/bin/env python3
"""ruff-baseline-lint — ratchet gate on ruff violations.

Phase 6.3 toolchain ratchet. Same shape as tools/except-pass-lint:
the current per-(file, rule) violation counts are frozen in
tools/ruff-baseline.txt; this gate BLOCKS any change that pushes a
(file, rule) count above its baseline, and the baseline only ratchets
DOWN as violations are fixed. New files start at zero — new code must
be ruff-clean.

Rule selection lives in ruff.toml (ruff's high-confidence defaults).
The pinned ruff version lives in ci.yml; results drift across ruff
releases, so a local mismatch prints a warning (CI is authoritative).

Usage:
  tools/ruff-baseline-lint --all                     # gate everything
  tools/ruff-baseline-lint <file.py> [...]           # gate specific files
  tools/ruff-baseline-lint --all --update-baseline   # re-freeze (counts must shrink)

Exit status: 0 if no (file, rule) exceeds its baseline; 1 otherwise.
"""
from __future__ import annotations

import argparse
import json
import shutil
import subprocess
import sys
from collections import Counter
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
BASELINE_PATH = REPO_ROOT / "tools" / "ruff-baseline.txt"

# Must match ruff.toml's coverage; passed explicitly so `--all` doesn't
# depend on cwd.
_LINT_PATHS = ("packages/admin/evolve_admin", "packages/analyzer", "tools")

PINNED_RUFF = "0.15.16"  # keep in sync with ci.yml + ruff.toml comment


def _ruff_bin() -> str:
    exe = shutil.which("ruff")
    if not exe:
        print(
            "ruff-baseline-lint: ruff not found on PATH. "
            f"Install with: pip install ruff=={PINNED_RUFF}",
            file=sys.stderr,
        )
        sys.exit(2)
    ver = subprocess.run([exe, "--version"], capture_output=True, text=True).stdout
    if PINNED_RUFF not in ver:
        print(
            f"ruff-baseline-lint: WARNING — local {ver.strip()} != pinned "
            f"ruff {PINNED_RUFF}; counts may differ from CI.",
            file=sys.stderr,
        )
    return exe


def _violations(targets: list[str]) -> Counter:
    """Counter keyed by 'relpath\\trule' from a ruff JSON run."""
    r = subprocess.run(
        [_ruff_bin(), "check", "--output-format", "json", "--exit-zero", *targets],
        capture_output=True, text=True, cwd=REPO_ROOT,
    )
    if r.returncode != 0:
        print(f"ruff-baseline-lint: ruff failed:\n{r.stderr}", file=sys.stderr)
        sys.exit(2)
    counts: Counter = Counter()
    for item in json.loads(r.stdout or "[]"):
        rel = str(Path(item["filename"]).resolve().relative_to(REPO_ROOT))
        counts[f"{rel}\t{item['code']}"] += 1
    return counts


def _load_baseline() -> dict[str, int]:
    if not BASELINE_PATH.exists():
        return {}
    out: dict[str, int] = {}
    for line in BASELINE_PATH.read_text().splitlines():
        line = line.rstrip()
        if not line or line.startswith("#"):
            continue
        parts = line.split("\t")
        if len(parts) != 3:
            continue
        count, rule, path = parts
        try:
            out[f"{path}\t{rule}"] = int(count)
        except ValueError:
            continue
    return out


def _write_baseline(counts: Counter) -> None:
    lines = [
        "# ruff-baseline — frozen per-(file, rule) violation counts.",
        "# Generated by `tools/ruff-baseline-lint --all --update-baseline`.",
        "# The gate blocks any (file, rule) that EXCEEDS its count here, so",
        "# this file may only ratchet DOWN. Goal state: empty.",
        "# Format: <count>\\t<rule>\\t<path>",
        "",
    ]
    for key in sorted(counts):
        path, rule = key.split("\t")
        lines.append(f"{counts[key]}\t{rule}\t{path}")
    BASELINE_PATH.write_text("\n".join(lines) + "\n")


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("files", nargs="*")
    ap.add_argument("--all", action="store_true")
    ap.add_argument("--update-baseline", action="store_true")
    args = ap.parse_args()

    if args.all:
        targets = list(_LINT_PATHS)
    elif args.files:
        targets = args.files
    else:
        ap.print_usage()
        return 2

    current = _violations(targets)

    if args.update_baseline:
        if not args.all:
            print("--update-baseline requires --all (whole-repo counts)", file=sys.stderr)
            return 2
        _write_baseline(current)
        print(f"baseline updated: {sum(current.values())} violations "
              f"across {len(current)} (file, rule) pairs")
        return 0

    baseline = _load_baseline()
    failed = False
    for key, n in sorted(current.items()):
        allowed = baseline.get(key, 0)
        if n > allowed:
            failed = True
            path, rule = key.split("\t")
            print(f"{path}: {rule} count {n} exceeds baseline {allowed} "
                  f"(+{n - allowed} new)")
    if failed:
        print(
            "\nruff-baseline-lint: new ruff violations (see above). Fix them, "
            "or run `ruff check <file>` to see details. The baseline only "
            "moves down — do not bump it for new code.",
            file=sys.stderr,
        )
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
