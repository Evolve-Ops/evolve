#!/usr/bin/env python3
"""pyright-baseline-lint — ratchet gate on pyright type errors.

Phase 6.3 toolchain ratchet. Same shape as tools/except-pass-lint and
tools/ruff-baseline-lint: current per-(file, rule) error counts are
frozen in tools/pyright-baseline.txt; the gate BLOCKS any change that
pushes a (file, rule) count above its baseline; the baseline only
ratchets DOWN. New files start at zero — new code type-checks clean.

The roadmap asked for "pyright on changed files only"; a FULL run is
~45s on a laptop (876 files) and avoids subset-analysis drift (pyright
counts for a file can differ when only part of the import graph is
analyzed), so the gate always runs the whole project per
pyrightconfig.json and compares per-file. CI pins the pyright version —
diagnostics drift across releases; keep PINNED_PYRIGHT in sync with
ci.yml when upgrading (and re-freeze the baseline in the same PR).

Usage:
  tools/pyright-baseline-lint                     # gate (full run)
  tools/pyright-baseline-lint --update-baseline   # re-freeze
  tools/pyright-baseline-lint --show <file>       # current errors for one file

Exit status: 0 if no (file, rule) exceeds baseline; 1 otherwise; 2 tooling error.
"""
from __future__ import annotations

import argparse
import json
import shutil
import subprocess
import sys
from collections import Counter
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
BASELINE_PATH = REPO_ROOT / "tools" / "pyright-baseline.txt"

PINNED_PYRIGHT = "1.1.410"  # keep in sync with ci.yml


def _pyright_bin() -> str:
    exe = shutil.which("pyright")
    if not exe:
        print(
            "pyright-baseline-lint: pyright not found on PATH. "
            f"Install with: pip install pyright=={PINNED_PYRIGHT}",
            file=sys.stderr,
        )
        sys.exit(2)
    ver = subprocess.run([exe, "--version"], capture_output=True, text=True).stdout
    if PINNED_PYRIGHT not in ver:
        print(
            f"pyright-baseline-lint: WARNING — local {ver.strip()} != pinned "
            f"{PINNED_PYRIGHT}; counts may differ from CI.",
            file=sys.stderr,
        )
    return exe


def _run_pyright() -> list[dict]:
    r = subprocess.run(
        [_pyright_bin(), "--outputjson"],
        capture_output=True, text=True, cwd=REPO_ROOT,
    )
    # pyright exits 1 when diagnostics exist — that's data, not failure.
    try:
        return json.loads(r.stdout)["generalDiagnostics"]
    except (json.JSONDecodeError, KeyError):
        print(f"pyright-baseline-lint: could not parse pyright output:\n"
              f"{r.stdout[:2000]}\n{r.stderr[:2000]}", file=sys.stderr)
        sys.exit(2)


def _counts(diags: list[dict]) -> Counter:
    counts: Counter = Counter()
    for d in diags:
        if d.get("severity") != "error":
            continue
        rel = str(Path(d["file"]).resolve().relative_to(REPO_ROOT))
        rule = d.get("rule", "syntax")
        counts[f"{rel}\t{rule}"] += 1
    return counts


def _load_baseline() -> dict[str, int]:
    if not BASELINE_PATH.exists():
        return {}
    out: dict[str, int] = {}
    for line in BASELINE_PATH.read_text().splitlines():
        line = line.rstrip()
        if not line or line.startswith("#"):
            continue
        parts = line.split("\t")
        if len(parts) != 3:
            continue
        count, rule, path = parts
        try:
            out[f"{path}\t{rule}"] = int(count)
        except ValueError:
            continue
    return out


def _write_baseline(counts: Counter) -> None:
    lines = [
        "# pyright-baseline — frozen per-(file, rule) type-error counts.",
        "# Generated by `tools/pyright-baseline-lint --update-baseline`",
        f"# with pyright {PINNED_PYRIGHT} (pinned in ci.yml — version bumps",
        "# re-freeze this file in the same PR).",
        "# The gate blocks any (file, rule) that EXCEEDS its count, so this",
        "# file only ratchets DOWN. Goal state: empty.",
        "# Format: <count>\\t<rule>\\t<path>",
        "",
    ]
    for key in sorted(counts):
        path, rule = key.split("\t")
        lines.append(f"{counts[key]}\t{rule}\t{path}")
    BASELINE_PATH.write_text("\n".join(lines) + "\n")


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--update-baseline", action="store_true")
    ap.add_argument("--show", metavar="FILE", help="print current errors for one file")
    args = ap.parse_args()

    diags = _run_pyright()

    if args.show:
        want = str(Path(args.show).resolve())
        for d in diags:
            if d.get("severity") == "error" and str(Path(d["file"]).resolve()) == want:
                rng = d.get("range", {}).get("start", {})
                print(f"{args.show}:{rng.get('line', 0) + 1}: "
                      f"[{d.get('rule', 'syntax')}] {d['message'].splitlines()[0]}")
        return 0

    current = _counts(diags)

    if args.update_baseline:
        _write_baseline(current)
        print(f"baseline updated: {sum(current.values())} errors "
              f"across {len(current)} (file, rule) pairs")
        return 0

    baseline = _load_baseline()
    failed = False
    for key, n in sorted(current.items()):
        allowed = baseline.get(key, 0)
        if n > allowed:
            failed = True
            path, rule = key.split("\t")
            print(f"{path}: {rule} count {n} exceeds baseline {allowed} "
                  f"(+{n - allowed} new)")
    if failed:
        print(
            "\npyright-baseline-lint: new type errors (see above). Run "
            "`tools/pyright-baseline-lint --show <file>` for details. The "
            "baseline only moves down — do not bump it for new code.",
            file=sys.stderr,
        )
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
