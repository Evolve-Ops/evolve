# CLI
# --------------------------------------------------------------------------------------


def _utc_now() -> str:
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _repo_slug(repo: Path) -> str | None:
    """The `repo_slug` from `.claude/meta.json`, so `gh` is never ambiguous about which
    remote it is talking to when the run happens inside a worktree."""
    try:
        data = json.loads((repo / ".claude" / "meta.json").read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
        return None
    slug = data.get("repo_slug")
    return slug if isinstance(slug, str) and slug.strip() else None


def _build_parser():
    ap = argparse.ArgumentParser(
        prog="pm-landing",
        description="Land the PM's staged manifests as branches + PRs (D-PM9).")
    ap.add_argument("--dir", default=DEFAULT_DIR,
                    help="manifest dir (default %s)" % DEFAULT_DIR)
    ap.add_argument("--sweep", action="store_true",
                    help="instead of landing: delete the untracked copies of files this "
                         "tool already landed, once %s carries them byte-identically"
                         % "origin/main")
    ap.add_argument("--remote", default="origin")
    ap.add_argument("--base", default="main")
    ap.add_argument("--repo-slug", default=None,
                    help="owner/name for gh (default: .claude/meta.json)")
    ap.add_argument("--dry-run", action="store_true",
                    help="report what would happen; change nothing")
    ap.add_argument("--json", action="store_true", help="machine-readable output")
    return ap


def main(argv=None):
    args = _build_parser().parse_args(argv)

    root = Path(args.dir).expanduser()
    repo = _repo_root(root if root.is_dir() else Path.cwd())
    if repo is None:
        print("pm-landing: not inside a git repository", file=sys.stderr)
        return EXIT_REFUSED
    if os.path.realpath(str(repo)) == os.path.realpath(DEPLOY_CHECKOUT):
        print("pm-landing: refusing to run in the deploy checkout (%s) — the repo-puller "
              "pulls it --ff-only every 15 minutes and the files this tool writes are "
              "untracked there. Run it in the operator's dev clone." % DEPLOY_CHECKOUT,
              file=sys.stderr)
        return EXIT_REFUSED
    root = root.resolve() if root.is_dir() else (repo / args.dir)
    if not root.is_dir():
        print("pm-landing: no manifest dir at %s" % root, file=sys.stderr)
        return EXIT_REFUSED

    try:
        if args.sweep:
            result = sweep(repo, root, remote=args.remote, base=args.base,
                           dry_run=args.dry_run)
        else:
            result = land(repo, root, remote=args.remote, base=args.base,
                          repo_slug=args.repo_slug or _repo_slug(repo),
                          now=_utc_now(), dry_run=args.dry_run)
    except Refused as e:
        print("pm-landing: refused: %s" % e, file=sys.stderr)
        return EXIT_REFUSED
    except OSError as e:
        print("pm-landing: %s" % e, file=sys.stderr)
        return EXIT_REFUSED

    if args.json:
        sys.stdout.write(json.dumps(result, indent=2, ensure_ascii=False) + "\n")
    else:
        lines = [r["log"] for r in result["results"] if r.get("log")]
        sys.stdout.write(("\n".join(lines) if lines else
                          "nothing to do (%s)" % result["dir"]) + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
