def _load_sessions(path):
    """Read --sessions-json: a JSON list of {title,...} dicts or bare title strings."""
    try:
        data = json.loads(Path(path).expanduser().read_text())
    except (OSError, ValueError) as e:
        raise SystemExit("meta-inflight: --sessions-json unreadable: %s" % e)
    if not isinstance(data, list):
        raise SystemExit("meta-inflight: --sessions-json must be a JSON list")
    return data


def main(argv=None):
    ap = argparse.ArgumentParser(
        prog="meta-inflight",
        description="Dispatch-time overlap check: who is already on this aspect/keywords/scope?",
    )
    ap.add_argument("--aspect", help="the work's aspect id")
    ap.add_argument("--keywords", help="comma-separated keywords")
    ap.add_argument("--scope", help="comma-separated file globs the work intends to touch")
    ap.add_argument("--dir", help="ledger dir override (default: glob under $HOME/.claude/projects)")
    ap.add_argument("--repo", default=DEFAULT_REPO, help="GitHub repo OWNER/REPO for the PR scan")
    ap.add_argument("--sessions-json", help="path to a JSON list of live session titles/objects")
    ap.add_argument("--no-prs", action="store_true", help="skip the gh open-PR scan")
    ap.add_argument("--pr-limit", type=int, default=80, help="max open PRs to list (default 80)")
    ap.add_argument("--limit", type=int, default=12,
                    help="max overlaps to show in text mode (0 = all; --json always returns all)")
    ap.add_argument("--claims-dir", help="dispatch-claim registry dir override "
                    "(default: ~/.claude/meta-state/claims)")
    ap.add_argument("--no-claims", action="store_true", help="skip the dispatch-claim scan")
    ap.add_argument("--prune", action="store_true",
                    help="prune expired claims and exit (no overlap scan)")
    ap.add_argument("--today", help="reference date YYYY-MM-DD (reserved; default today)")
    ap.add_argument("--json", action="store_true", help="emit the result as JSON")
    args = ap.parse_args(argv)

    claims_dir = Path(args.claims_dir).expanduser() if args.claims_dir else DEFAULT_CLAIMS_DIR

    # --prune: a maintenance path — age out expired claims and report, no overlap scan.
    if args.prune:
        before = len(list(claims_dir.glob("*.json"))) if claims_dir.exists() else 0
        kept = load_claims(claims_dir, prune=True)
        pruned = before - len(kept)
        if args.json:
            sys.stdout.write(json.dumps(
                {"claims_dir": str(claims_dir), "pruned": pruned, "active": len(kept)},
                indent=2) + "\n")
        else:
            sys.stdout.write("Pruned %d expired claim(s); %d active remain (%s).\n"
                             % (pruned, len(kept), claims_dir))
        return 0

    if not (args.aspect or args.keywords or args.scope):
        print("meta-inflight: give at least one of --aspect / --keywords / --scope",
              file=sys.stderr)
        return 2
    if args.today and _parse_date(args.today) is None:
        print("meta-inflight: --today must be YYYY-MM-DD", file=sys.stderr)
        return 2

    ledger_dir = resolve_ledger_dir(args.dir)
    if ledger_dir is None:
        where = args.dir or ("$HOME/.claude/projects/%s/memory/meta-state"
                             % meta_config.memory_slug())
        print("meta-inflight: could not resolve ledger dir (%s)" % where, file=sys.stderr)
        return 2

    sessions = _load_sessions(args.sessions_json) if args.sessions_json else None
    query = make_query(args.aspect, args.keywords, args.scope)
    result = run(ledger_dir, query, args.repo, sessions,
                 scan_prs=not args.no_prs, pr_limit=args.pr_limit,
                 claims_dir=(None if args.no_claims else claims_dir))
    if args.json:
        sys.stdout.write(render_json(result))
    else:
        sys.stdout.write(render_text(result, limit=(None if args.limit == 0 else args.limit)))
    return 0


if __name__ == "__main__":
    sys.exit(main())
