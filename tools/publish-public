# --------------------------------------------------------------------------
# Manifest
# --------------------------------------------------------------------------
def _glob_list(data: dict, key: str, manifest_path: Path) -> list[str]:
    """Validate ``data[key]`` as a list of non-empty glob strings."""
    globs = data.get(key, [])
    if globs is None:
        globs = []
    if not isinstance(globs, list):
        raise ValueError(
            f"{manifest_path}: '{key}' must be a list, got {type(globs).__name__}"
        )
    out: list[str] = []
    for i, entry in enumerate(globs):
        if not isinstance(entry, str) or not entry.strip():
            raise ValueError(
                f"{manifest_path}: {key}[{i}] must be a non-empty string, got {entry!r}"
            )
        out.append(entry.strip())
    return out


def load_manifest_split(path: Path | None = None) -> tuple[list[str], list[str]]:
    """Parse docs/public-manifest.yaml → (private globs, public_docs globs).

    Raises ValueError on malformed YAML, unknown top-level keys, or a value
    that is not a list of non-empty strings.
    """
    import yaml  # PyYAML is an existing dependency.

    manifest_path = path or DEFAULT_MANIFEST
    try:
        raw = manifest_path.read_text(encoding="utf-8")
    except OSError as exc:
        raise ValueError(f"cannot read manifest {manifest_path}: {exc}") from exc

    try:
        data = yaml.safe_load(raw)
    except yaml.YAMLError as exc:
        raise ValueError(f"malformed YAML in {manifest_path}: {exc}") from exc

    if not isinstance(data, dict):
        raise ValueError(
            f"{manifest_path}: top level must be a mapping, got {type(data).__name__}"
        )
    unknown = set(data) - _ALLOWED_TOP_KEYS
    if unknown:
        raise ValueError(
            f"{manifest_path}: unknown top-level key(s): {', '.join(sorted(unknown))}. "
            f"Only {sorted(_ALLOWED_TOP_KEYS)} are allowed."
        )
    return _glob_list(data, "private", manifest_path), _glob_list(
        data, "public_docs", manifest_path
    )


def load_manifest(path: Path | None = None) -> list[str]:
    """Parse docs/public-manifest.yaml and return the list of private globs."""
    return load_manifest_split(path)[0]


# --------------------------------------------------------------------------
# Glob matching (gitignore-ish; handles ** without the pathspec dependency)
# --------------------------------------------------------------------------
def _glob_to_regex(glob: str) -> re.Pattern[str]:
    """Translate a repo-root-relative glob to a full-path-anchored regex.

    Semantics (a deliberate, small subset of gitignore):
      ``**``  matches any number of characters, INCLUDING ``/``.
      ``*``   matches any number of characters EXCEPT ``/`` (one segment).
      ``?``   matches a single character except ``/``.
    Everything else is matched literally. We avoid fnmatch because its ``*``
    spans ``/``, which would make ``docs/forensic-*`` silently match nested
    paths and blur the cut line.
    """
    i, n = 0, len(glob)
    out = ["(?s:"]
    while i < n:
        c = glob[i]
        if c == "*":
            if glob[i : i + 2] == "**":
                i += 2
                out.append(".*")
            else:
                out.append("[^/]*")
                i += 1
            continue
        if c == "?":
            out.append("[^/]")
        else:
            out.append(re.escape(c))
        i += 1
    out.append(r")\Z")
    return re.compile("".join(out))


def compile_globs(globs: list[str]) -> list[tuple[str, re.Pattern[str]]]:
    """Pair each glob string with its compiled regex (order preserved)."""
    return [(g, _glob_to_regex(g)) for g in globs]


def first_matching_glob(
    rel_posix: str, compiled: list[tuple[str, re.Pattern[str]]]
) -> str | None:
    """Return the first glob string that matches rel_posix, or None."""
    for glob, pattern in compiled:
        if pattern.match(rel_posix):
            return glob
    return None


# --------------------------------------------------------------------------
# Tracked files + partition
# --------------------------------------------------------------------------
def tracked_files(root: Path = REPO_ROOT) -> list[str]:
    """Repo-root-relative POSIX paths tracked by git at HEAD."""
    proc = subprocess.run(
        ["git", "ls-files"],
        cwd=root,
        capture_output=True,
        text=True,
        check=True,
    )
    return [line for line in proc.stdout.splitlines() if line]


def partition(
    tracked: list[str],
    compiled: list[tuple[str, re.Pattern[str]]],
    *,
    public_docs_compiled: list[tuple[str, re.Pattern[str]]] | None = None,
    sanitize_targets: frozenset[str] = frozenset(),
) -> tuple[list[str], list[tuple[str, str]]]:
    """Split tracked paths into (public, excluded).

    public   — sorted list of repo-relative paths that ship.
    excluded — sorted list of (path, glob) for paths removed, where glob is
               the denylist glob that matched or DOCS_PRIVATE_BY_DEFAULT_LABEL.

    Non-``docs/`` paths ship unless a ``private`` glob matches (public by
    default). ``docs/`` paths are PRIVATE BY DEFAULT (PD-3b): they ship only
    if they match ``public_docs_compiled`` or are a publish-time sanitize
    target (``sanitize_targets``, repo-relative paths) — and the denylist
    still wins on conflict, always. Passing ``public_docs_compiled=None``
    allowlists nothing, so a caller that forgets the allowlist ships FEWER
    files, never more (fail-closed).
    """
    public: list[str] = []
    excluded: list[tuple[str, str]] = []
    for rel in tracked:
        glob = first_matching_glob(rel, compiled)
        if glob is not None:
            excluded.append((rel, glob))
            continue
        if rel.startswith("docs/") and rel not in sanitize_targets:
            if public_docs_compiled is None or (
                first_matching_glob(rel, public_docs_compiled) is None
            ):
                excluded.append((rel, DOCS_PRIVATE_BY_DEFAULT_LABEL))
                continue
        public.append(rel)
    public.sort()
    excluded.sort()
    return public, excluded


def docs_sanitize_targets() -> frozenset[str]:
    """The ``docs/`` paths that ship SANITIZED (tools/publish_sanitize.py).

    These are their own classification under the reconciliation invariant —
    a sanitize target is never also allowlisted or denylisted — and they ship
    by virtue of being targets, so they need no ``public_docs`` entry.
    """
    sanitize = _load_sanitize_module()
    return frozenset(
        rel for rel in sanitize.target_paths() if rel.startswith("docs/")
    )


# --------------------------------------------------------------------------
# Scrub (reused from the launch-scrub test — token list + scan + exemptions)
# --------------------------------------------------------------------------
def _load_scrub_module():
    """Load the reserved-token scrub module by path (it has a .py name but
    lives under tests/). Lazy so importers that only need the manifest/glob
    helpers (e.g. the CI guard) never pull in pytest, which this module
    imports at top level."""
    loader = SourceFileLoader("public_launch_scrub", str(_SCRUB_SRC))
    spec = importlib.util.spec_from_loader("public_launch_scrub", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


# Publish-time content sanitizer (PUBLIC-2). A handful of dev-apparatus files keep
# their real reference-deployment detail in the private repo (the permission gate +
# Claude's own ssh detail depend on it) and are sanitized only in the PUBLIC OUTPUT.
# We apply it at the point the scrub reads each public file, so the scrub always sees
# WHAT WOULD SHIP. It is a no-op for every non-target path. This is orthogonal to the
# path-exemption logic below (which is PUBLIC-3's): sanitizing changes the *content*
# scanned, not *which* paths are scanned.
_SANITIZE_SRC = REPO_ROOT / "tools" / "publish_sanitize.py"


def _load_sanitize_module():
    loader = SourceFileLoader("publish_sanitize", str(_SANITIZE_SRC))
    spec = importlib.util.spec_from_loader("publish_sanitize", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def run_scrub(public_paths: list[str], root: Path = REPO_ROOT) -> list[tuple[str, int, str, str]]:
    """Scan ONLY the public subset for reserved tokens.

    Reuses the launch-scrub module's RESERVED_TOKENS, per-line scanner
    (``_violations_in``) and binary skiplist — so the token list and the
    legitimate-inline-token strips (e.g. @eslint/plugin-kit, sentry-sdk)
    cannot drift from the CI scrub guard. The critical invariant: the scan
    iterates ``public_paths`` and nothing else, so a private file's tokens
    can never mask, or be masked by, the public verdict.

    PATH EXEMPTIONS ARE DECOUPLED. We deliberately do NOT reuse the scrub
    module's ``_is_allowlisted`` (= the private-CI ``ALLOWLISTED_PATHS`` /
    ``ALLOWLISTED_PREFIXES``). That allowlist exists to keep token-bearing
    test fixtures from reddening the *private* repo's CI; reusing it here
    would let any such file that isn't ALSO manifest-denied ship to the
    public repo WITH its tokens while this gate reported PASS (the PUBLIC-3
    blind spot). Instead we exempt ONLY ``PUBLIC_OUTPUT_EXEMPTIONS`` — an
    explicit, minimal, separately-documented set — so PASS means "no
    reserved tokens in any shipped file outside that named set."

    Returns a list of (rel_path, lineno, token, snippet) violations.
    """
    scrub = _load_scrub_module()
    sanitize = _load_sanitize_module()
    violations: list[tuple[str, int, str, str]] = []
    for rel in public_paths:
        path = root / rel
        if not path.is_file():
            continue
        if rel in PUBLIC_OUTPUT_EXEMPTIONS:
            continue
        if path.suffix.lower() in scrub._BINARY_EXTENSIONS:
            continue
        try:
            text = path.read_text(encoding="utf-8")
        except (OSError, UnicodeDecodeError):
            continue
        # Scan WHAT WOULD SHIP: publish-time sanitization is applied to the
        # load-bearing dev-apparatus files (no-op for everything else). PUBLIC-2.
        text = sanitize.sanitize_public_text(rel, text)
        for lineno, line in enumerate(text.splitlines(), start=1):
            for match in scrub._violations_in(line):
                snippet = line.strip()
                if len(snippet) > 110:
                    snippet = snippet[:107] + "..."
                violations.append((rel, lineno, match, snippet))
    return violations


def exempted_but_token_bearing(
    public_paths: list[str], root: Path = REPO_ROOT
) -> list[str]:
    """Public-shipping files that ARE exempt but STILL contain reserved
    tokens — i.e. the live, load-bearing members of PUBLIC_OUTPUT_EXEMPTIONS.

    Surfaced in the dry-run so a PASS is never a silent green: the operator
    sees exactly which shipped files still carry tokens pending the
    PUBLIC-2 publish-time transform. Also lets a regression test prove the
    exemption set is not hiding a dead (token-free) entry.
    """
    scrub = _load_scrub_module()
    out: list[str] = []
    for rel in public_paths:
        if rel not in PUBLIC_OUTPUT_EXEMPTIONS:
            continue
        path = root / rel
        if not path.is_file() or path.suffix.lower() in scrub._BINARY_EXTENSIONS:
            continue
        try:
            text = path.read_text(encoding="utf-8")
        except (OSError, UnicodeDecodeError):
            continue
        if any(scrub._violations_in(line) for line in text.splitlines()):
            out.append(rel)
    return sorted(out)


# --------------------------------------------------------------------------
# WARN check: shipped files referencing denylisted paths (dead public links)
# --------------------------------------------------------------------------
# Path-like token: two or more /-joined segments (e.g. a docs path or a tool path).
_PATHREF_RE = re.compile(r"[A-Za-z0-9_.\-]+(?:/[A-Za-z0-9_.\-]+)+")
# Markdown-link target: [text](spec-foo.md#anchor) — catches doc-relative links
# that carry no directory prefix and so miss the token regex above.
_MDLINK_RE = re.compile(r"\]\(([^)#?\s]+)")


def denylisted_references(
    public_paths: list[str],
    excluded_paths: list[str],
    root: Path = REPO_ROOT,
) -> list[tuple[str, str]]:
    """WARN-level: shipped files that reference now-denylisted paths.

    A public doc linking to a denylisted path is a broken link in the public
    tree (the target never ships). This is advisory, never a gate: each hit is
    a rewrite-or-accept judgment call (e.g. CLAUDE.md ships sanitized and cites
    spec files by design). Matches both repo-rooted path tokens
    (``docs/spec-foo.md``) and doc-relative markdown links (``](spec-foo.md)``),
    plus references to a denylisted DIRECTORY (a dir all of whose tracked
    content is excluded).

    Returns sorted (shipping_file, referenced_denylisted_path) pairs.
    """
    scrub = _load_scrub_module()
    excluded = set(excluded_paths)
    public_set = set(public_paths)

    def _ancestors(rel: str):
        parts = rel.split("/")
        for i in range(1, len(parts)):
            yield "/".join(parts[:i])

    # A directory reference counts only if the dir contains excluded files and
    # NO public ones (e.g. "docs" is an ancestor of both → not flagged).
    excluded_dirs = {d for p in excluded for d in _ancestors(p)}
    excluded_dirs -= {d for p in public_set for d in _ancestors(p)}

    hits: set[tuple[str, str]] = set()
    for rel in public_paths:
        path = root / rel
        if not path.is_file() or path.suffix.lower() in scrub._BINARY_EXTENSIONS:
            continue
        try:
            text = path.read_text(encoding="utf-8")
        except (OSError, UnicodeDecodeError):
            continue
        parent_dir = posixpath.dirname(rel)  # git paths are always posix
        candidates = set(_PATHREF_RE.findall(text))
        for target in _MDLINK_RE.findall(text):
            target = target.strip().rstrip("/")
            if not target or target.startswith(("http://", "https://", "mailto:", "/")):
                continue
            # Resolve the doc-relative link against the referencing file's dir
            # and normalize ./ and ../ segments without touching the filesystem.
            joined = posixpath.join(parent_dir, target) if parent_dir else target
            candidates.add(posixpath.normpath(joined))
        for cand in candidates:
            cand = cand.rstrip("/.")
            if cand in excluded or cand in excluded_dirs:
                hits.add((rel, cand))
    return sorted(hits)


# --------------------------------------------------------------------------
# Report + CLI
# --------------------------------------------------------------------------
def compute(manifest_path: Path | None = None) -> dict:
    """Run the full dry-run computation and return a structured result."""
    globs, public_docs_globs = load_manifest_split(manifest_path)
    compiled = compile_globs(globs)
    tracked = tracked_files()
    public, excluded = partition(
        tracked,
        compiled,
        public_docs_compiled=compile_globs(public_docs_globs),
        sanitize_targets=docs_sanitize_targets(),
    )
    violations = run_scrub(public)
    return {
        "globs": globs,
        "public_docs_globs": public_docs_globs,
        "tracked_count": len(tracked),
        "public": public,
        "excluded": excluded,
        "violations": violations,
        "exempted_with_tokens": exempted_but_token_bearing(public),
        "denylist_references": denylisted_references(public, [p for p, _ in excluded]),
    }


def _print_dry_run(result: dict) -> None:
    public = result["public"]
    excluded = result["excluded"]
    violations = result["violations"]

    print("=== tools/publish-public --dry-run ===")
    print(f"Manifest globs ({len(result['globs'])}):")
    for g in result["globs"]:
        print(f"  - {g}")
    print()
    pub_docs_globs = result.get("public_docs_globs", [])
    print(
        f"Docs allowlist ({len(pub_docs_globs)} public_docs glob(s); "
        f"docs/ is PRIVATE by default — PD-3b):"
    )
    for g in pub_docs_globs:
        print(f"  - {g}")
    print()
    docs_public = [p for p in public if p.startswith("docs/")]
    print(f"Tracked at HEAD : {result['tracked_count']}")
    print(f"Public files    : {len(public)}  (docs/: {len(docs_public)})")
    print(f"Excluded (private): {len(excluded)}")
    print()

    print("Public sample (first 15):")
    for rel in public[:15]:
        print(f"  {rel}")
    if len(public) > 15:
        print(f"  ... and {len(public) - 15} more")
    print()

    print(f"Excluded files ({len(excluded)}) — path  <-  excluding glob:")
    for rel, glob in excluded:
        print(f"  {rel}  <-  {glob}")
    print()

    exempted = result.get("exempted_with_tokens", [])

    if violations:
        shown = violations[:40]
        print(
            f"SCRUB: FAIL — {len(violations)} reserved-token hit(s) in shipped "
            f"files OUTSIDE the public-output exemption set:"
        )
        for rel, lineno, token, snippet in shown:
            print(f"  {rel}:{lineno}  [{token}]  {snippet}")
        if len(violations) > 40:
            print(f"  ... and {len(violations) - 40} more")
        print()
        print(
            "These are deployment-specific identifiers that must be scrubbed "
            "before the public mirror can be published (see "
            "docs/PLACEHOLDER_NAMING.md). The dry-run is doing its job: it "
            "DETECTED them. Re-scrubbing the offending files is a separate task."
        )
    else:
        suffix = (
            f"outside the {len(PUBLIC_OUTPUT_EXEMPTIONS)} documented "
            "public-output exemption(s)."
            if PUBLIC_OUTPUT_EXEMPTIONS
            else "(the exemption set is empty — nothing is knowingly shipped "
            "with tokens; the load-bearing files are sanitized at publish time)."
        )
        print(f"SCRUB: PASS — no reserved tokens in any shipped file {suffix}")
    print()

    # Never a silent green: always surface the exemption set so a PASS can
    # be audited. These files ship WITH reserved tokens and need PUBLIC-2's
    # publish-time transform before the mirror is truly clean.
    if exempted:
        print(
            f"Public-output exemptions ({len(exempted)} of "
            f"{len(PUBLIC_OUTPUT_EXEMPTIONS)} still contain reserved tokens; "
            f"PUBLIC-2 must apply a publish-time transform before these ship clean):"
        )
        for rel in exempted:
            print(f"  {rel}")
        print()

    refs = result.get("denylist_references", [])
    if refs:
        # Reader-facing docs first (a rendered markdown link that 404s is the
        # real cost); code/test references (spec citations in comments) are
        # summarized — full detail in --json.
        doc_refs = [(r, t) for r, t in refs if r.endswith((".md", ".html"))]
        code_count = len(refs) - len(doc_refs)
        print(
            f"WARN: {len(refs)} reference(s) to denylisted paths in shipped "
            f"files (broken links in the public tree — rewrite or accept each; "
            f"advisory, never blocks)."
        )
        if doc_refs:
            print(f"  Reader-facing docs ({len(doc_refs)}):")
            for rel, target in doc_refs:
                print(f"    {rel}  ->  {target}")
        if code_count:
            print(
                f"  ... and {code_count} more from code/tests (spec citations "
                f"in comments/docstrings — see --json for the full list)."
            )
        print()

    print("DRY RUN — no commits, no network, nothing published.")


class PublishAborted(RuntimeError):
    """Raised when a safety gate fails during --execute (scrub, rescrub, dirty tree)."""


# --------------------------------------------------------------------------
# Publish build (the manual runbook Phase 4–5, automated)
# --------------------------------------------------------------------------
def _working_tree_clean(root: Path = REPO_ROOT) -> bool:
    """True if `git status --porcelain` is empty (HEAD == working tree)."""
    proc = subprocess.run(
        ["git", "status", "--porcelain"],
        cwd=root,
        capture_output=True,
        text=True,
        check=True,
    )
    return not proc.stdout.strip()


def build_public_tree(
    dest: Path, manifest_path: Path | None = None, root: Path = REPO_ROOT
) -> dict:
    """Materialize the sanitized public output tree into ``dest``.

    Computes the public subset (tracked − denylist), runs the reserved-token
    scrub on it, and ABORTS (PublishAborted) if the scrub finds anything. Then
    writes every public file into ``dest``, applying the publish-time sanitizer
    (publish_sanitize.sanitize_public_text) to text files — so ``dest`` holds
    exactly WHAT SHIPS: private paths removed, load-bearing dev-apparatus files
    sanitized, org-URL links rewritten. Binary files are copied verbatim; the
    executable bit is preserved.

    Returns the compute() result dict augmented with ``written``/``sanitized``
    counts. Does NOT touch git or the network.
    """
    result = compute(manifest_path)
    if result["violations"]:
        raise PublishAborted(
            f"scrub FAILED on the public subset: {len(result['violations'])} "
            f"reserved-token hit(s). Refusing to build a leaking tree."
        )
    sanitize = _load_sanitize_module()
    scrub = _load_scrub_module()
    dest = Path(dest)
    written = 0
    sanitized = 0
    for rel in result["public"]:
        src = root / rel
        # Skip anything not a regular file at HEAD (e.g. a submodule gitlink or
        # a path removed in the working tree). git ls-files can list gitlinks.
        if not src.is_file():
            continue
        out_path = dest / rel
        out_path.parent.mkdir(parents=True, exist_ok=True)
        is_binary = src.suffix.lower() in scrub._BINARY_EXTENSIONS
        text: str | None = None
        if not is_binary:
            try:
                text = src.read_text(encoding="utf-8")
            except (OSError, UnicodeDecodeError):
                is_binary = True  # undecodable → treat as binary, copy verbatim
        if is_binary or text is None:
            shutil.copyfile(src, out_path)
        else:
            new = sanitize.sanitize_public_text(rel, text)
            if new != text:
                sanitized += 1
            out_path.write_text(new, encoding="utf-8")
        shutil.copymode(src, out_path)
        written += 1
    result["written"] = written
    result["sanitized"] = sanitized
    return result


def rescrub_tree(dest: Path) -> list[tuple[str, int, str, str]]:
    """Belt-and-suspenders: scan the BUILT tree on disk for reserved tokens.

    Zero exemptions — the built tree contains no legitimately token-bearing
    file (fixtures/ops-docs are manifest-denied; the five load-bearing files
    are sanitized). Any hit here is a real leak in the artifact about to be
    published. Returns (rel, lineno, token, snippet) violations.
    """
    scrub = _load_scrub_module()
    dest = Path(dest)
    violations: list[tuple[str, int, str, str]] = []
    for path in sorted(dest.rglob("*")):
        if not path.is_file():
            continue
        # Skip .git plumbing: reflogs (.git/logs/*) record the LOCAL committer
        # identity (which may be a reserved token) but are never pushed, so they
        # are not part of the shipped artifact. In the real _execute flow rescrub
        # runs before `git init` so this is belt-and-suspenders for callers that
        # scan an already-committed tree.
        if ".git" in path.parts:
            continue
        if path.suffix.lower() in scrub._BINARY_EXTENSIONS:
            continue
        try:
            text = path.read_text(encoding="utf-8")
        except (OSError, UnicodeDecodeError):
            continue
        rel = str(path.relative_to(dest))
        for lineno, line in enumerate(text.splitlines(), start=1):
            for match in scrub._violations_in(line):
                snippet = line.strip()
                if len(snippet) > 110:
                    snippet = snippet[:107] + "..."
                violations.append((rel, lineno, match, snippet))
    return violations


def _git(dest: Path, *args: str) -> subprocess.CompletedProcess:
    return subprocess.run(
        ["git", *args], cwd=dest, capture_output=True, text=True, check=True
    )


# --------------------------------------------------------------------------
# Provenance marker + --status (PD-4 forward-sync; no network)
# --------------------------------------------------------------------------
def read_provenance(path: Path | None = None) -> dict | None:
    """Read the last-publish marker, or None if absent/unreadable/malformed.

    Fail-open on a bad marker: --status degrades to "no publish recorded"
    rather than blocking (the marker is informational, never a gate)."""
    marker = path or PROVENANCE_PATH
    try:
        data = json.loads(marker.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    return data if isinstance(data, dict) else None


def write_provenance(
    *,
    private_head_sha: str,
    public_commit_sha: str,
    published_at: str,
    public_file_count: int,
    target: str,
    path: Path | None = None,
) -> Path:
    """Record what was just published. Written only after a successful push."""
    marker = path or PROVENANCE_PATH
    marker.parent.mkdir(parents=True, exist_ok=True)
    marker.write_text(
        json.dumps(
            {
                "private_head_sha": private_head_sha,
                "public_commit_sha": public_commit_sha,
                "published_at": published_at,
                "public_file_count": public_file_count,
                "target": target,
            },
            indent=2,
        )
        + "\n",
        encoding="utf-8",
    )
    return marker


def _status(args: argparse.Namespace) -> int:
    """Report drift between the last published release and private HEAD.

    Reads only the local git repo + the provenance marker — NO network calls.
    """
    print("=== tools/publish-public --status ===")
    try:
        result = compute(args.manifest)
    except ValueError as exc:
        print(f"publish-public: {exc}", file=sys.stderr)
        return 2
    public_set = set(result["public"])

    marker = read_provenance()
    if marker is None:
        try:
            shown = PROVENANCE_PATH.relative_to(REPO_ROOT)
        except ValueError:
            shown = PROVENANCE_PATH
        print(f"No provenance marker at {shown}.")
        print(
            "Either nothing has been published from this checkout yet, or the "
            "marker predates --status. It is written automatically on the next "
            "successful --execute --push."
        )
        print()
        print(f"Public files at HEAD : {len(public_set)}")
        print(f"Scrub                : {'PASS' if not result['violations'] else 'FAIL'}")
        return 0

    last_sha = str(marker.get("private_head_sha", ""))
    head = _git(REPO_ROOT, "rev-parse", "HEAD").stdout.strip()
    print(f"Last published       : {marker.get('published_at', 'unknown')}")
    print(f"  target             : {marker.get('target', 'unknown')}")
    print(f"  public commit      : {str(marker.get('public_commit_sha', 'unknown'))[:12]}")
    print(f"  public file count  : {marker.get('public_file_count', 'unknown')}")
    print(f"  private HEAD then  : {last_sha[:12] or 'unknown'}")
    print(f"Private HEAD now     : {head[:12]}")

    # The recorded sha may be unknown to this clone (marker copied across
    # machines, history rewritten) — degrade to "cannot compute drift".
    known = (
        bool(last_sha)
        and subprocess.run(
            ["git", "cat-file", "-e", f"{last_sha}^{{commit}}"],
            cwd=REPO_ROOT,
            capture_output=True,
        ).returncode
        == 0
    )
    if not known:
        print()
        print(
            f"Recorded private sha {last_sha[:12] or '(empty)'} is not a commit "
            f"in this clone — cannot compute drift. Re-publish to refresh the marker."
        )
        return 0

    behind = int(
        _git(REPO_ROOT, "rev-list", "--count", f"{last_sha}..HEAD").stdout.strip()
    )
    changed = [
        line
        for line in _git(
            REPO_ROOT, "diff", "--name-only", last_sha, "HEAD"
        ).stdout.splitlines()
        if line in public_set
    ]
    print()
    print(f"Private commits since last publish : {behind}")
    print(f"Changed files in the public subset : {len(changed)}")
    for rel in changed[:20]:
        print(f"  {rel}")
    if len(changed) > 20:
        print(f"  ... and {len(changed) - 20} more")
    print()
    if behind == 0:
        print("Public snapshot is current with private HEAD.")
    else:
        print(
            "To republish (Model A — one squashed commit, force-push by design):\n"
            f"  tools/publish-public --execute --target {marker.get('target', '<url>')} "
            "--push --i-understand-this-publishes"
        )
    return 0


# --------------------------------------------------------------------------
# --skip-if-unchanged: don't force-push a byte-identical snapshot
# --------------------------------------------------------------------------
# Stable marker line so a CI log (and a test) can tell "skipped, already
# current" apart from "published".
SKIP_UNCHANGED_MARKER = (
    "PUBLISH: SKIPPED — the published snapshot is already byte-identical"
)


# The three answers the remote probe can give. CURRENT and DRIFTED are
# CONCLUSIONS about the published artifact; UNKNOWN means the probe could not
# reach one. Never collapse UNKNOWN into either — "cannot tell" read as "fine"
# is exactly the failure this file's drift check exists to end.
DRIFT_CURRENT = "current"
DRIFT_DRIFTED = "drifted"
DRIFT_UNKNOWN = "unknown"


def probe_published_snapshot(
    dest: Path, target: str, author_email: str | None = None
) -> tuple[str, str, dict]:
    """Compare the built snapshot in ``dest`` against what is actually published.

    Returns ``(state, reason, details)`` where state is one of
    ``DRIFT_CURRENT`` / ``DRIFT_DRIFTED`` / ``DRIFT_UNKNOWN``:

    * ``current``  — the remote is a Model-A-shaped, correctly-authored single
      commit whose tree is identical to the built one;
    * ``drifted``  — the remote was read and is NOT that (different tree, wrong
      author, more than one commit);
    * ``unknown``  — the remote could not be read at all.

    ``details`` carries whatever facts were established (best effort): the
    remote commit/tree/author/commit-count and the built tree id.

    Compares the freshly built commit's **tree object id** against the remote
    tip's. Git tree ids are content-addressed over paths + modes + blob
    contents and carry no commit metadata, so equal tree ids mean the published
    artifact is byte-identical to what we would push — a force-push would only
    churn the commit sha.

    Why identity-of-content and NOT "did this push touch a public path": the
    obvious cheap filter is to diff the pushed commit range against the
    denylist, but under GitHub's concurrency rules a QUEUED workflow run is
    cancelled when a newer one queues behind an in-progress run. Its commit's
    public changes would then never be published, and the next run — diffing
    only from ITS predecessor — would see nothing public and skip. That is
    silent public-repo lag, i.e. exactly the failure this automation exists to
    end. Comparing against what is actually published cannot lose a commit,
    and it self-heals drift from any cause (a hand-push, a failed run, a
    snapshot that predates the automation).

    The remote must ALSO be a Model-A-shaped, correctly-authored single commit
    for a skip to be safe; otherwise we republish to repair it.

    Fetches into a throwaway BARE repo, never into ``dest`` — a shallow fetch
    would mark ``dest`` shallow and can make the subsequent force-push refuse.

    Reads only. Takes no credential of its own: the target is fetched with
    whatever ambient git auth exists, and ``evolve-ops/evolve`` has been PUBLIC
    since 2026-07-28, so an unauthenticated fetch succeeds.
    """
    details: dict = {}
    probe = Path(tempfile.mkdtemp(prefix="evolve-public-probe-"))
    try:
        init = subprocess.run(
            ["git", "init", "--quiet", "--bare", str(probe)],
            capture_output=True,
            text=True,
        )
        if init.returncode != 0:
            return DRIFT_UNKNOWN, "could not create the comparison repo", details
        # depth 2 (not 1) so `rev-list --count` can distinguish "exactly one
        # commit" (Model A) from "more than one".
        fetch = subprocess.run(
            ["git", "fetch", "--quiet", "--depth", "2", target, "main"],
            cwd=probe,
            capture_output=True,
            text=True,
        )
        if fetch.returncode != 0:
            return (
                DRIFT_UNKNOWN,
                "remote main is unreadable or has no commits yet",
                details,
            )
        try:
            count = _git(probe, "rev-list", "--count", "FETCH_HEAD").stdout.strip()
            remote_tree = _git(probe, "rev-parse", "FETCH_HEAD^{tree}").stdout.strip()
            remote_commit = _git(probe, "rev-parse", "FETCH_HEAD").stdout.strip()
            remote_author = _git(
                probe, "log", "-1", "--format=%an <%ae>", "FETCH_HEAD"
            ).stdout.strip()
            remote_files = [
                line
                for line in _git(
                    probe, "ls-tree", "-r", "--name-only", "FETCH_HEAD"
                ).stdout.splitlines()
                if line
            ]
            local_tree = _git(dest, "rev-parse", "HEAD^{tree}").stdout.strip()
        except subprocess.CalledProcessError:
            return DRIFT_UNKNOWN, "could not read the remote snapshot", details
    finally:
        shutil.rmtree(probe, ignore_errors=True)

    details.update(
        {
            "public_commit": remote_commit,
            "public_tree": remote_tree,
            "public_author": remote_author,
            "public_commit_count": count,
            "public_files": remote_files,
            "built_tree": local_tree,
        }
    )
    if count != "1":
        return (
            DRIFT_DRIFTED,
            f"remote has {count} commits, not the Model A single commit",
            details,
        )
    expected_author = f"{PUBLIC_AUTHOR_NAME} <{author_email or PUBLIC_AUTHOR_EMAIL}>"
    if remote_author != expected_author:
        return (
            DRIFT_DRIFTED,
            f"remote author is {remote_author!r}, expected {expected_author!r}",
            details,
        )
    if remote_tree != local_tree:
        return (
            DRIFT_DRIFTED,
            f"tree differs (remote {remote_tree[:12]}, built {local_tree[:12]})",
            details,
        )
    return (
        DRIFT_CURRENT,
        f"identical tree {local_tree[:12]}, single commit, public author",
        details,
    )


def new_public_offenders(
    public_now: list[str],
    published_files: list[str] | None,
    public_docs_compiled: list[tuple[str, re.Pattern[str]]],
    sanitize_targets: frozenset[str] = frozenset(),
) -> list[tuple[str, str]] | None:
    """Part D publish gate: newly-public paths that need a human's explicit say.

    ``new_public`` is public_now − the published snapshot's file list. Each
    element must be covered by an explicit classification to flow unattended:

    * a ``docs/`` path must match ``public_docs`` (or be a sanitize target) —
      belt-and-braces over the partition semantics, so a regression back to
      docs-public-by-default still cannot ship silently;
    * a root file (no ``/``) flows — root community files are known-public;
    * anything else must sit under an EXISTING top level that is also in
      ``KNOWN_PUBLIC_PREFIXES``. A brand-new top-level directory, or a prefix
      outside the known set, is an unclassified surface.

    Returns the offending (path, reason) list — empty when the gate is
    satisfied — or ``None`` when ``published_files`` is ``None`` (the remote
    could not be read; the caller must fail closed, not shrug: "could not
    look" must never read as "fine").
    """
    if published_files is None:
        return None
    published = set(published_files)
    published_tops = {p.split("/", 1)[0] for p in published if "/" in p}
    offenders: list[tuple[str, str]] = []
    for rel in public_now:
        if rel in published:
            continue
        if rel.startswith("docs/"):
            if rel in sanitize_targets:
                continue
            if first_matching_glob(rel, public_docs_compiled) is None:
                offenders.append((rel, "docs/ path with no public_docs match"))
            continue
        if "/" not in rel:
            continue
        top = rel.split("/", 1)[0]
        if top not in published_tops:
            offenders.append((rel, f"introduces new top-level directory {top}/"))
        elif not rel.startswith(KNOWN_PUBLIC_PREFIXES):
            offenders.append((rel, f"prefix {top}/ not in KNOWN_PUBLIC_PREFIXES"))
    return offenders


def published_snapshot_matches(
    dest: Path, target: str, author_email: str | None = None
) -> tuple[bool, str]:
    """Is the remote ALREADY exactly the snapshot we just built? (--skip-if-unchanged)

    Thin wrapper over :func:`probe_published_snapshot`: ONLY ``current`` is a
    safe skip, so both ``drifted`` and ``unknown`` answer False. ``matches`` is
    False on ANY uncertainty — a wrong "skip" is the harmful direction (silent
    public-repo lag), a wrong "publish" only churns the commit sha.
    """
    state, reason, _details = probe_published_snapshot(dest, target, author_email)
    return state == DRIFT_CURRENT, reason


# --------------------------------------------------------------------------
# --verify: post-push inspection of the ACTUAL published artifact
# --------------------------------------------------------------------------
def _verify(args: argparse.Namespace) -> int:
    """Fresh throwaway clone of --target → reserved-token grep + metadata check.

    Mirrors the manual verification done at the 2026-07-01 cutover: the thing
    inspected is the REMOTE artifact (what the world sees), not the local build.
    Checks: exactly one commit (Model A), author is the public identity, and
    zero reserved tokens in any shipped file (rescrub_tree, zero exemptions).
    """
    if not args.target:
        print("--verify requires --target <git-remote-url>.", file=sys.stderr)
        return 2
    clone = Path(tempfile.mkdtemp(prefix="evolve-public-verify-"))
    try:
        subprocess.run(
            ["git", "clone", "--quiet", args.target, str(clone)],
            capture_output=True,
            text=True,
            check=True,
        )
    except subprocess.CalledProcessError as exc:
        print(f"publish-public: --verify clone failed: {exc.stderr}", file=sys.stderr)
        shutil.rmtree(clone, ignore_errors=True)
        return 3

    failures: list[str] = []
    commit_count = int(_git(clone, "rev-list", "--count", "HEAD").stdout.strip())
    if commit_count != 1:
        failures.append(
            f"expected exactly 1 commit (Model A: per-release squashed snapshot), "
            f"found {commit_count}"
        )
    author = _git(clone, "log", "-1", "--format=%an <%ae>").stdout.strip()
    expected_author = (
        f"{PUBLIC_AUTHOR_NAME} <{args.author_email or PUBLIC_AUTHOR_EMAIL}>"
    )
    if author != expected_author:
        failures.append(f"author is {author!r}, expected {expected_author!r}")

    leaks = rescrub_tree(clone)
    if leaks:
        failures.append(f"{len(leaks)} reserved-token hit(s) in the published tree")

    file_count = sum(
        1 for p in clone.rglob("*") if p.is_file() and ".git" not in p.parts
    )
    shutil.rmtree(clone, ignore_errors=True)

    print("=== tools/publish-public --verify ===")
    print(f"Target          : {args.target}")
    print(f"Commits         : {commit_count}")
    print(f"Author          : {author}")
    print(f"Files in clone  : {file_count}")
    if leaks:
        for rel, lineno, token, snippet in leaks[:20]:
            print(f"  LEAK {rel}:{lineno}  [{token}]  {snippet}")
    if failures:
        print("VERIFY: FAIL")
        for f in failures:
            print(f"  - {f}")
        return 3
    print("VERIFY: PASS — single squashed commit, public author, zero reserved tokens.")
    return 0


def _commit_public_tree(dest: Path, author_email: str | None) -> str:
    """git init a fresh repo in ``dest`` and make ONE squashed public commit.

    No history is carried from the private repo (PD-2). Returns the commit SHA.
    """
    _git(dest, "init", "-q", "-b", "main")
    if author_email:
        _git(dest, "config", "user.email", author_email)
        _git(dest, "config", "user.name", "Evolve")
    _git(dest, "add", "-A")
    msg = (
        "Evolve — public release\n\n"
        "Curated public snapshot published from the private dev repo via\n"
        "tools/publish-public. https://evolveops.dev\n"
    )
    _git(dest, "commit", "-q", "-m", msg)
    return _git(dest, "rev-parse", "HEAD").stdout.strip()


# --------------------------------------------------------------------------
# --check-drift: is the PUBLISHED artifact still the current main?
# --------------------------------------------------------------------------
# WHY THIS MODE EXISTS. The republish automation
# (.github/workflows/publish-public.yml) can stop republishing while every run
# still concludes SUCCESS: its secret gate SKIPS GREEN when
# PUBLIC_REPO_PUSH_TOKEN is absent, and that skip is deliberate (a permanently
# red main teaches people to ignore CI). Measured 2026-08-11: the snapshot had
# been overdue on 32 consecutive pushes for 12 days, with 32 green runs.
#
# The defect was never the skip — it was that the skip produced no durable,
# surfaced signal. So this check is deliberately OUTCOME-based and
# CAUSE-AGNOSTIC: it asks only "is the published tree what main would publish
# right now?" A missing secret is one cause; a revoked or expired PAT, a push
# that 400s on http.postBuffer, an out-of-band force-push to the public repo,
# a --skip-if-unchanged tree-id bug, and any future refactor that skips for a
# brand-new reason all produce the same symptom, and only an outcome check
# catches all of them.
#
# NO CREDENTIAL. evolve-ops/evolve is PUBLIC (since 2026-07-28), so the compare
# reads the published HEAD unauthenticated. This is load-bearing: a detector
# that needed the very token whose absence it is detecting would be useless.
# This mode never pushes, never writes the provenance marker, and never touches
# PUBLIC_REPO_PUSH_TOKEN.
DRIFT_MARKER_PREFIX = "PUBLISH-DRIFT: "

# Exit codes, chosen so a caller can branch without parsing text: 0 = current,
# 1 = drifted (the alarm condition), 3 = could not tell (also actionable — an
# unreadable public repo is itself news). 2 stays "bad invocation", as in the
# other modes.
DRIFT_EXIT_CODES = {DRIFT_CURRENT: 0, DRIFT_DRIFTED: 1, DRIFT_UNKNOWN: 3}


def _sleep(seconds: float) -> None:
    """Confirmation wait, behind an indirection.

    A module-level seam (rather than patching the process-global
    ``time.sleep``) so tests can drive the confirmation re-probe without
    stealing sleeps from other threads in the same pytest process.
    """
    time.sleep(seconds)


def _head_facts(root: Path = REPO_ROOT) -> tuple[str, str]:
    """(sha, ISO-8601 commit date) of the private HEAD being compared."""
    try:
        sha = _git(root, "rev-parse", "HEAD").stdout.strip()
        when = _git(root, "log", "-1", "--format=%cI", "HEAD").stdout.strip()
    except subprocess.CalledProcessError:
        return "", ""
    return sha, when


def _checkout_description(root: Path = REPO_ROOT) -> str:
    """"<branch> (clean|dirty)" — reported so a DRIFTED verdict cannot be
    misread. The comparison is against THIS tree, so running the check from a
    feature branch or a dirty tree explains a difference all by itself."""
    try:
        branch = _git(root, "rev-parse", "--abbrev-ref", "HEAD").stdout.strip()
        clean = _working_tree_clean(root)
    except subprocess.CalledProcessError:
        return "unknown"
    return f"{branch} ({'clean' if clean else 'DIRTY'})"


def check_publish_drift(
    target: str,
    *,
    manifest_path: Path | None = None,
    author_email: str | None = None,
    confirm_after: float = 0.0,
    build_dir: Path | None = None,
    build=None,
    sleep=None,
    root: Path = REPO_ROOT,
) -> dict:
    """Build the public tree from the current checkout and compare it to what
    is published at ``target``.

    ``confirm_after`` seconds > 0: a non-current first verdict is RE-PROBED
    after that wait, and the second verdict wins. This is a confirmation, not a
    grace period — it cannot turn a real drift green, it only absorbs the two
    races that would otherwise produce a self-clearing false alarm (a push
    mid-check, and a publish run still in flight). The built tree is reused, so
    the confirmation costs one extra fetch, not one extra build.

    ``build`` is the build seam (``build(dest) -> result dict``); the default
    materializes the real sanitized public tree. Injectable so the state
    machine can be tested without a ~3.4k-file build per case.

    Returns a result dict; ``state`` is one of DRIFT_CURRENT / DRIFT_DRIFTED /
    DRIFT_UNKNOWN. Never raises on a build or network failure — those are
    reported as ``unknown``, which is an alarm state, not a pass.
    """
    sleep = sleep or _sleep
    build = build or (lambda dest: build_public_tree(dest, manifest_path, root))
    head_sha, head_when = _head_facts(root)
    result: dict = {
        "mode": "check-drift",
        "target": target,
        "private_head": head_sha,
        "private_head_committed_at": head_when,
        "checkout": _checkout_description(root),
        "checked_at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
        "confirm_after_seconds": confirm_after,
        "attempts": [],
    }

    if build_dir is not None:
        dest = Path(build_dir)
        if dest.exists() and any(dest.iterdir()):
            result["state"] = DRIFT_UNKNOWN
            result["reason"] = f"--build-dir {dest} is not empty"
            return result
        dest.mkdir(parents=True, exist_ok=True)
    else:
        dest = Path(tempfile.mkdtemp(prefix="evolve-public-drift-"))
    result["build_dir"] = str(dest)

    try:
        # A scrub failure, a dead denylist glob, or an unreadable tree all mean
        # the expected artifact cannot be computed — so the honest answer is
        # "cannot tell", never "current". (The push workflow owns turning those
        # red; here they must not read as a pass.)
        # Broad on purpose. Anything the builder raises — PublishAborted (scrub),
        # ValueError (dead denylist glob), OSError, or a plain bug — means the
        # same thing to a detector: the expected artifact could not be computed.
        # Letting an unexpected type escape would exit 1, which the alarm reads
        # as "drifted", pointing the operator at the publish token for what is
        # actually a tool bug.
        try:
            built = build(dest)
        except Exception as exc:
            result["state"] = DRIFT_UNKNOWN
            result["reason"] = f"cannot build the expected public tree: {exc!r}"
            return result
        result["public_file_count"] = built.get("written")

        # Always pass an author email: the probe compares the remote's
        # author-of-record against it, and a bare CI runner may have no git
        # identity configured at all (the commit would fail).
        author = author_email or PUBLIC_AUTHOR_EMAIL
        try:
            _commit_public_tree(dest, author)
        except subprocess.CalledProcessError as exc:
            result["state"] = DRIFT_UNKNOWN
            result["reason"] = f"cannot commit the expected public tree: {exc}"
            return result

        state, reason, details = probe_published_snapshot(dest, target, author)
        result["attempts"].append({"state": state, "reason": reason})
        if state != DRIFT_CURRENT and confirm_after > 0:
            sleep(confirm_after)
            state, reason, retry_details = probe_published_snapshot(dest, target, author)
            # Keep the first probe's facts if the retry established none (an
            # unreadable remote reports no tree ids) — the verdict is the
            # retry's, the reported facts are the best that were established.
            details = retry_details or details
            result["attempts"].append({"state": state, "reason": reason})
        result.update(details)
        result["state"] = state
        result["reason"] = reason
        return result
    finally:
        # A ~3.5k-file tree per run adds up on a machine that checks daily. An
        # explicit --build-dir is the caller asking to keep it for inspection; a
        # mkdtemp is not, so it goes.
        if build_dir is None:
            shutil.rmtree(dest, ignore_errors=True)


_DRIFT_REMEDIATION = {
    DRIFT_DRIFTED: """\
The published snapshot is NOT what THIS checkout would publish. If the Checkout
line above is not a clean `main`, that alone explains the difference — the
comparison is against the tree you are standing in.

Otherwise the published snapshot is stale. This check is cause-agnostic — it
reports the OUTCOME, so work down the causes:

  1. Is the repo secret PUBLIC_REPO_PUSH_TOKEN configured on the private repo?
     While it is absent, .github/workflows/publish-public.yml SKIPS GREEN on
     every push and nothing is republished.
  2. Has that token expired, been revoked, or lost `Contents: write` on
     evolve-ops/evolve?
  3. Did a publish run fail AFTER its gates (push 400, network, force-push
     refused)? Check the run history of .github/workflows/publish-public.yml.
  4. Was the public repo force-pushed, edited, or restored out of band?

Heal it by re-running the publish workflow (Actions -> publish-public -> Run
workflow), or via the break-glass manual path in
docs/runbook-public-cutover.md, "Republish".""",
    DRIFT_UNKNOWN: """\
The check could NOT determine whether the published snapshot is current. That
is an alarm state, not a pass: either the expected tree could not be built
(scrub failure, dead denylist glob) or the published artifact could not be read
(repo renamed/deleted/flipped private, network). Read the reason above and fix
the check before trusting a later green.""",
}


def _check_drift(args: argparse.Namespace) -> int:
    """Report whether the published artifact still matches this checkout."""
    if not args.target:
        print("--check-drift requires --target <git-remote-url>.", file=sys.stderr)
        return 2

    # The outer boundary of the same rule: a detector that CRASHES must report
    # "cannot tell" (exit 3), never fall through to the interpreter's exit 1 —
    # which the alarm would read as "drifted" and send the operator hunting a
    # publish-credential problem that does not exist. The exception is printed,
    # not swallowed.
    try:
        result = check_publish_drift(
            args.target,
            manifest_path=args.manifest,
            author_email=args.author_email,
            confirm_after=args.confirm_after,
            build_dir=args.build_dir,
        )
    except Exception as exc:
        result = {
            "mode": "check-drift",
            "state": DRIFT_UNKNOWN,
            "reason": f"the drift check itself failed: {exc!r}",
            "target": args.target,
            "private_head": "",
            "private_head_committed_at": "",
            "checkout": "unknown",
            "attempts": [],
        }

    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
        return DRIFT_EXIT_CODES[result["state"]]

    print("=== tools/publish-public --check-drift ===")
    print(f"Target             : {result['target']}")
    print(
        f"Private HEAD       : {result['private_head'][:12]} "
        f"({result['private_head_committed_at']})"
    )
    print(f"Checkout           : {result['checkout']}")
    if result.get("public_file_count") is not None:
        print(f"Public files built : {result['public_file_count']}")
    for label, key in (
        ("Built tree         ", "built_tree"),
        ("Published commit   ", "public_commit"),
        ("Published tree     ", "public_tree"),
    ):
        if result.get(key):
            print(f"{label}: {str(result[key])[:12]}")
    if result.get("public_author"):
        print(f"Published author   : {result['public_author']}")
    if result.get("public_commit_count"):
        print(f"Published commits  : {result['public_commit_count']}")
    if len(result["attempts"]) > 1:
        print(
            f"Confirmation       : re-probed after "
            f"{result['confirm_after_seconds']:g}s "
            f"({' -> '.join(a['state'] for a in result['attempts'])})"
        )
    print()
    print(f"{DRIFT_MARKER_PREFIX}{result['state'].upper()} — {result['reason']}")
    remediation = _DRIFT_REMEDIATION.get(result["state"])
    if remediation:
        print()
        print(remediation)
    return DRIFT_EXIT_CODES[result["state"]]


def _execute(args: argparse.Namespace) -> int:
    """Build the sanitized public tree, gate it, commit it, and (optionally) push.

    This automates runbook Phase 4–5. The genuinely irreversible steps —
    creating the public GitHub repo and flipping it public — remain operator
    actions (Phase 5–7); this tool stops at "a scrub-clean, committed local
    tree" unless a --target remote is given with --push.
    """
    if not args.i_understand_this_publishes:
        print(
            "Refusing to --execute without --i-understand-this-publishes.",
            file=sys.stderr,
        )
        return 2
    if not args.build_only and not args.target:
        print(
            "Refusing to --execute without --target <git-remote-url> "
            "(or pass --build-only to build+commit a local tree without pushing).",
            file=sys.stderr,
        )
        return 2
    if not args.allow_dirty and not _working_tree_clean():
        print(
            "Refusing to publish from a DIRTY working tree — HEAD would not match "
            "what ships. Commit/stash first, or pass --allow-dirty if intentional.",
            file=sys.stderr,
        )
        return 2

    if args.build_dir:
        dest = Path(args.build_dir)
        if dest.exists() and any(dest.iterdir()):
            print(f"Refusing to build into non-empty --build-dir {dest}.", file=sys.stderr)
            return 2
        dest.mkdir(parents=True, exist_ok=True)
    else:
        dest = Path(tempfile.mkdtemp(prefix="evolve-public-"))

    try:
        result = build_public_tree(dest, args.manifest)
    except PublishAborted as exc:
        print(f"publish-public: ABORT — {exc}", file=sys.stderr)
        return 3

    leaks = rescrub_tree(dest)
    if leaks:
        print(
            f"publish-public: ABORT — rescrub of the BUILT tree found "
            f"{len(leaks)} reserved-token hit(s):",
            file=sys.stderr,
        )
        for rel, lineno, token, snippet in leaks[:20]:
            print(f"  {rel}:{lineno}  [{token}]  {snippet}", file=sys.stderr)
        return 3

    sha = _commit_public_tree(dest, args.author_email)

    print("=== tools/publish-public --execute ===")
    print(f"Built tree      : {dest}")
    print(f"Public files    : {result['written']}")
    print(f"Sanitized files : {result['sanitized']}")
    print(f"Excluded (private): {len(result['excluded'])}")
    print("SCRUB           : PASS (subset) + PASS (built-tree rescrub, 0 exemptions)")
    print(f"Squashed commit : {sha[:12]}")

    if args.target and args.push:
        _git(dest, "remote", "add", "origin", args.target)
        # One probe serves both the Part D newly-public gate and
        # --skip-if-unchanged (no second fetch).
        state, probe_reason, details = probe_published_snapshot(
            dest, args.target, args.author_email
        )
        if not args.allow_new_public:
            offenders = new_public_offenders(
                result["public"],
                details.get("public_files"),
                compile_globs(result["public_docs_globs"]),
                docs_sanitize_targets(),
            )
            if offenders is None:
                print(
                    f"publish-public: ABORT — cannot read the published snapshot "
                    f"({probe_reason}), so the newly-public gate cannot compute "
                    f"what this push would newly expose. Refusing to publish. "
                    f"For a deliberate first publish to an empty/unreadable "
                    f"remote, re-run locally with --allow-new-public.",
                    file=sys.stderr,
                )
                return 3
            if offenders:
                print(
                    f"publish-public: ABORT — {len(offenders)} newly-public "
                    f"path(s) lack an explicit classification (Part D gate):",
                    file=sys.stderr,
                )
                for rel, why in offenders[:40]:
                    print(f"  {rel}  [{why}]", file=sys.stderr)
                if len(offenders) > 40:
                    print(f"  ... and {len(offenders) - 40} more", file=sys.stderr)
                print(
                    "\nA human must classify these: add docs/ paths to "
                    "public_docs: in docs/public-manifest.yaml (that IS the "
                    "confirmation) or to private:; for a genuinely new "
                    "non-docs surface, extend KNOWN_PUBLIC_PREFIXES in "
                    "tools/publish-public. Local deliberate bypass: "
                    "--allow-new-public (CI never sets it).",
                    file=sys.stderr,
                )
                return 3
        if args.skip_if_unchanged:
            matches = state == DRIFT_CURRENT
            print(f"Already published?: {'yes' if matches else 'no'} — {probe_reason}")
            if matches:
                print()
                print(SKIP_UNCHANGED_MARKER)
                print("Nothing pushed; the public repo is already current.")
                return 0
        # FORCE by design (Model A): each release is a fresh `git init` + one
        # squashed commit sharing no history with the remote, so a plain push
        # is always rejected as non-fast-forward. The public repo is always
        # exactly one commit; no public history accumulates.
        #
        # Surface git's own stderr on failure. _git uses check=True +
        # capture_output, and CalledProcessError's message does NOT include the
        # captured stderr — so an unhandled failure here would give a bare
        # traceback with no git diagnostic, which is unusable in CI logs. The
        # message is safe to print because --target carries NO credential: auth
        # comes from the ambient git credential config (see
        # .github/workflows/publish-public.yml), never from the URL.
        try:
            _git(dest, "push", "--force", "-u", "origin", "main")
        except subprocess.CalledProcessError as exc:
            print(
                f"publish-public: ABORT — force-push to {args.target} failed "
                f"(exit {exc.returncode}). Nothing was published; the built tree "
                f"is at {dest}.",
                file=sys.stderr,
            )
            for stream in (exc.stdout, exc.stderr):
                if stream:
                    print(stream.rstrip(), file=sys.stderr)
            return 3
        print(f"Pushed          : {args.target} (main, --force — Model A snapshot)")
        marker = write_provenance(
            private_head_sha=_git(REPO_ROOT, "rev-parse", "HEAD").stdout.strip(),
            public_commit_sha=sha,
            published_at=datetime.now(timezone.utc).isoformat(timespec="seconds"),
            public_file_count=result["written"],
            target=args.target,
        )
        print(f"Provenance      : {marker}")
        print()
        print("Next: tools/publish-public --verify --target " + args.target)
        print("Then: close public issues fixed in this release (runbook PD-4 step 4).")
    else:
        print()
        print("NOT pushed (no --target/--push). To publish this artifact:")
        print(f"  cd {dest}")
        print("  gh repo create evolve-ops/evolve --private \\")
        print('    --description "Packaging layer for OpenClaw — Linux/Ubuntu for AI agents on your hardware" \\')
        print("    --source=. --remote=origin --push")
        print("  # inspect (Phase 6), then flip public:")
        print("  gh repo edit evolve-ops/evolve --visibility public")
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="publish-public",
        description="Compute (and, when explicitly authorized, push) the public mirror.",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Compute and print the public/private split + scrub result (default).",
    )
    parser.add_argument(
        "--execute",
        action="store_true",
        help="Publish for real (guarded; per-release manual republish, PD-4).",
    )
    parser.add_argument(
        "--status",
        action="store_true",
        help="Report drift since the last published release (provenance marker "
        "at docs/private/last-public-release.json). No network calls.",
    )
    parser.add_argument(
        "--skip-if-unchanged",
        action="store_true",
        help="With --execute --push: skip the force-push when the remote is "
        "already a correctly-authored single commit whose tree is identical to "
        "the freshly built snapshot. Fails safe (publishes) on any uncertainty. "
        "Used by the CI publish workflow so private-only changes don't churn "
        "the public commit sha.",
    )
    parser.add_argument(
        "--verify",
        action="store_true",
        help="Fresh throwaway clone of --target: reserved-token grep + "
        "single-squashed-commit/author check on the PUBLISHED artifact.",
    )
    parser.add_argument(
        "--check-drift",
        action="store_true",
        help="Read-only outcome check: build the public tree from this checkout "
        "and report whether --target's published snapshot still matches it. "
        "Never pushes, needs no credential. Exit 0 current / 1 drifted / "
        "3 could-not-tell. Used by the scheduled drift alarm "
        "(.github/workflows/publish-drift.yml).",
    )
    parser.add_argument(
        "--confirm-after",
        type=float,
        default=0.0,
        metavar="SECONDS",
        help="With --check-drift: on a non-current verdict, wait this long and "
        "re-probe the remote once; the second verdict wins. Absorbs the "
        "push-mid-check and publish-still-in-flight races without being able to "
        "turn a real drift green. Default 0 (single probe).",
    )
    parser.add_argument(
        "--i-understand-this-publishes",
        action="store_true",
        help="Required acknowledgement flag for --execute.",
    )
    parser.add_argument(
        "--target",
        metavar="GIT_REMOTE_URL",
        help="Public remote to push to (required for --execute unless --build-only).",
    )
    parser.add_argument(
        "--build-only",
        action="store_true",
        help="With --execute: build+commit the sanitized tree locally, do NOT push "
        "(no --target needed). The safe way to inspect the artifact first.",
    )
    parser.add_argument(
        "--build-dir",
        type=Path,
        default=None,
        metavar="DIR",
        help="With --execute: where to materialize the public tree (must be empty; "
        "default: a fresh mkdtemp). Kept so the operator can inspect/clone it.",
    )
    parser.add_argument(
        "--push",
        action="store_true",
        help="With --execute --target: actually push to the remote (default: no push).",
    )
    parser.add_argument(
        "--author-email",
        default=None,
        metavar="EMAIL",
        help="With --execute: author-of-record for the squashed public commit "
        "(e.g. hello@evolveops.dev). Default: the committing git identity.",
    )
    parser.add_argument(
        "--allow-new-public",
        action="store_true",
        help="With --execute --push: bypass the newly-public gate (Part D) that "
        "refuses to ship paths absent from the published snapshot unless they "
        "are explicitly classified (public_docs / known prefixes). For "
        "deliberate local publishes only — CI never sets it.",
    )
    parser.add_argument(
        "--allow-dirty",
        action="store_true",
        help="With --execute: permit publishing from a dirty working tree "
        "(default: refuse, since HEAD would not match what ships).",
    )
    parser.add_argument(
        "--manifest",
        type=Path,
        default=None,
        help=f"Path to the manifest (default: {DEFAULT_MANIFEST.relative_to(REPO_ROOT)}).",
    )
    parser.add_argument(
        "--json",
        action="store_true",
        help="Emit the dry-run result as JSON instead of a human report.",
    )
    args = parser.parse_args(argv)

    # Mode dispatch — deliberately NOT composable (see the module docstring).
    # In particular --verify wins over --execute, so `--execute --verify` in one
    # invocation publishes NOTHING. Callers must run --verify separately.
    # --check-drift sits ahead of --execute for the same reason: a read-only
    # check must never be one typo away from a force-push.
    if args.status:
        return _status(args)
    if args.check_drift:
        return _check_drift(args)
    if args.verify:
        return _verify(args)
    if args.execute:
        return _execute(args)

    # Default and --dry-run both land here — never publishes.
    try:
        result = compute(args.manifest)
    except ValueError as exc:
        print(f"publish-public: {exc}", file=sys.stderr)
        return 2

    if args.json:
        print(
            json.dumps(
                {
                    "globs": result["globs"],
                    "public_docs_globs": result["public_docs_globs"],
                    "tracked_count": result["tracked_count"],
                    "public_count": len(result["public"]),
                    "excluded_count": len(result["excluded"]),
                    "excluded": [{"path": p, "glob": g} for p, g in result["excluded"]],
                    "violation_count": len(result["violations"]),
                    "violations": [
                        {"path": p, "line": ln, "token": tk, "snippet": sn}
                        for p, ln, tk, sn in result["violations"]
                    ],
                    "scrub_passed": not result["violations"],
                    "public_output_exemptions": sorted(PUBLIC_OUTPUT_EXEMPTIONS),
                    "exempted_with_tokens": result.get("exempted_with_tokens", []),
                    "denylist_references": [
                        {"path": p, "references": t}
                        for p, t in result.get("denylist_references", [])
                    ],
                },
                indent=2,
            )
        )
    else:
        _print_dry_run(result)

    # Dry-run exit code reflects scrub health so callers can gate on it, but
    # the report is the real deliverable. Reserved tokens currently present
    # in public files are a known, separately-tracked re-scrub task.
    return 1 if result["violations"] else 0


if __name__ == "__main__":
    sys.exit(main())
