    { "name": "nested_ids_are_ignored_top_level_only", "manifest": { "meta": { "pkg_id": "nested" }, "instance_id": "app-d" }, "expected_id": "app-d" },
    { "name": "no_id_fields", "manifest": { "name": "morning-briefing" }, "expected_id": null },
    { "name": "all_id_fields_empty", "manifest": { "pkg_id": "", "id": "", "spec_id": "", "instance_id": "" }, "expected_id": null },
    { "name": "non_object_manifest_null", "manifest": null, "expected_id": null },
    { "name": "non_object_manifest_list", "manifest": ["pkg_id", "app-a"], "expected_id": null }
