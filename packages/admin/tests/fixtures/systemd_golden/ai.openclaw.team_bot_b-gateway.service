# Generated by Evolve (runtime.scheduler.render_systemd_units) — do not edit.
[Unit]
Description=OpenClaw Gateway for team_bot_b (headless, survives logout)
StartLimitIntervalSec=0

[Service]
User=personal_bot_user
Group=staff
UMask=0077
Environment="HOME=/home/personal_bot_user"
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
Environment="OPENCLAW_GATEWAY_PORT=18790"
Environment="OPENCLAW_LAUNCHD_LABEL=ai.openclaw.team_bot_b-gateway"
ExecStart=/usr/bin/node /usr/lib/node_modules/openclaw/dist/index.js gateway --port 18790
Restart=always
RestartSec=5
StandardOutput=append:/home/personal_bot_user/.openclaw/logs/gateway.log
StandardError=append:/home/personal_bot_user/.openclaw/logs/gateway.err.log

[Install]
WantedBy=multi-user.target
