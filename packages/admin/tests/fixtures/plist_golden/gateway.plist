<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>ai.openclaw.team_bot_b-gateway</string>
    <key>Comment</key>
    <string>OpenClaw Gateway for team_bot_b (runs as personal_bot_user, headless, survives GUI logout)</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>UserName</key>
    <string>personal_bot_user</string>
    <key>GroupName</key>
    <string>staff</string>
    <key>Umask</key>
    <integer>63</integer>
    <key>ProgramArguments</key>
    <array>
      <string>/opt/homebrew/bin/node</string>
      <string>/opt/homebrew/lib/node_modules/openclaw/dist/index.js</string>
      <string>gateway</string>
      <string>--port</string>
      <string>18790</string>
    </array>
    <key>StandardOutPath</key>
    <string>/Users/personal_bot_user/.openclaw/logs/gateway.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/personal_bot_user/.openclaw/logs/gateway.err.log</string>
    <key>EnvironmentVariables</key>
    <dict>
      <key>HOME</key>
      <string>/Users/personal_bot_user</string>
      <key>TMPDIR</key>
      <string>/tmp</string>
      <key>PATH</key>
      <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
      <key>NODE_EXTRA_CA_CERTS</key>
      <string>/etc/ssl/cert.pem</string>
      <key>OPENCLAW_GATEWAY_PORT</key>
      <string>18790</string>
      <key>OPENCLAW_LAUNCHD_LABEL</key>
      <string>ai.openclaw.team_bot_b-gateway</string>
      <key>OPENCLAW_SERVICE_MARKER</key>
      <string>openclaw</string>
      <key>OPENCLAW_SERVICE_KIND</key>
      <string>gateway</string>
    </dict>
  </dict>
</plist>