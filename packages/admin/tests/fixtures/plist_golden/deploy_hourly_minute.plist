<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.evolve.evolve.hourly-tick</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/Shared/evolve-venv/bin/python3</string>
        <string>/Users/Shared/evolve-repo/packages/analyzer/tick.py</string>
    </array>
    <key>UserName</key>
    <string>evolve</string>
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Minute</key>
            <integer>15</integer>
        </dict>
    </array>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/evolve/.openclaw/logs/evolve-evolve.hourly-tick.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/evolve/.openclaw/logs/evolve-evolve.hourly-tick.err.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>PYTHONPATH</key>
        <string>/Users/Shared/evolve-repo/packages/analyzer</string>
        <key>EVOLVE_NETWORK</key>
        <string>/Users/Shared/evolve/network.json</string>
    </dict>
</dict>
</plist>