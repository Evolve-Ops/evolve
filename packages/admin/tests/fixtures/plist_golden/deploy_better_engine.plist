<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.openclaw.evolve.better</string>
    <key>UserName</key>
    <string>evolve</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>sleep $((RANDOM % 5)); exec /Users/Shared/evolve-venv/bin/python3 /Users/Shared/evolve-repo/packages/analyzer/better_engine_refresh.py</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/evolve</string>
        <key>EVOLVE_SHARED</key>
        <string>/Users/Shared/evolve</string>
    </dict>
    <key>StartInterval</key>
    <integer>900</integer>
    <key>WatchPaths</key>
    <array>
        <string>/Users/Shared/evolve/better-engine/.refresh-urgent</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/Shared/evolve/logs/better_engine.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/Shared/evolve/logs/better_engine.err</string>
</dict>
</plist>